    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" /></noscript>
    <title>{title}</title>
    <meta name="description" content={description} />
      
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-VGKZVCWFXQ"></script>
<script is:inline>
  // is:inline keeps gtag global. Astro used to bundle this as a module, so window.gtag never existed
  // and every lead event on the site was silently dropped (fixed 10 Oct 2026).
  window.dataLayer = window.dataLayer || [];
  window.gtag = function(){ window.dataLayer.push(arguments); };
  // Only the production host reports to GA4, so localhost and Vercel previews stop polluting the data.
  if (location.hostname === 'www.presciaiq.com.au') {
    gtag('js', new Date());
    gtag('config', 'G-VGKZVCWFXQ');
    // Lead events: a successful Web3Forms submit is a lead; a Calendly link click is a booking intent.
    var nativeFetch = window.fetch;
    window.fetch = function(input, init) {
      var url = typeof input === 'string' ? input : (input && input.url) || '';
      var p = nativeFetch.apply(this, arguments);
      if (url.indexOf('api.web3forms.com/submit') !== -1) {
        p.then(function(res){ if (res && res.ok) { gtag('event', 'generate_lead', { lead_source: 'web_form', page_path: location.pathname }); } }).catch(function(){});
      }
      return p;
    };
    document.addEventListener('click', function(e){
      var a = e.target && e.target.closest ? e.target.closest('a[href*="calendly.com"]') : null;
      if (a) { gtag('event', 'book_call_click', { page_path: location.pathname }); }
    }, true);
  }
</script>


    <!-- SEO: Primary Meta Tags -->
