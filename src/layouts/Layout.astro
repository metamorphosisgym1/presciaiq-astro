---
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer";
import AuditPopup from "../components/AuditPopup";
import SmoothScroll from '../components/SmoothScroll.tsx';
import AmbientBackground from "../components/AmbientBackground.astro";

export interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  noindex?: boolean;
  lightMode?: boolean;
}

const {
  title = "PresciaIQ — Australia's Predictive AI Company | BuildPredictIQ, AdsIQ, Daynori",
  description = "PresciaIQ engineers intelligent systems and predictive AI platforms for Australian enterprises — construction risk forecasting, ROAS prediction, autonomous agent workflows, and Daynori. Based in Sydney, built for Australia.",
  canonicalURL,
  noindex = false,
  lightMode = false,
} = Astro.props;

const resolvedCanonical = new URL(
  canonicalURL || Astro.url.pathname,
  Astro.site ?? Astro.url.origin,
).href;
---

<!doctype html>
<html lang="en" class="overflow-x-clip">
