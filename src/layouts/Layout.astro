    <script is:inline>
      (function () {
        if (typeof window === "undefined") return;

        // Respect accessibility reduced-motion preference
        var prefersReducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        if (prefersReducedMotion) return;

        function initScrollReveal() {
          var mainEl = document.querySelector("main");
          if (!mainEl) return;

          var sections = mainEl.querySelectorAll(
            "[data-scroll-reveal]",
          );
          if (!sections || !sections.length) return;

          var revealIndex = 0;
          var windowHeight =
            window.innerHeight || document.documentElement.clientHeight;

          var observer = new IntersectionObserver(
            function (entries, obs) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-revealed");
                  obs.unobserve(entry.target);
                }
              });
            },
            {
              root: null,
              rootMargin: "0px 0px -50px 0px",
              threshold: 0.05,
            },
          );

          sections.forEach(function (sec, idx) {
            if (sec.dataset.scrollRevealInit) return;
            sec.dataset.scrollRevealInit = "true";

            // Hero section must load instantly with ZERO delay or opacity blocker
            if (
              idx === 0 ||
              sec.id === "hero" ||
              sec.hasAttribute("data-hero") ||
              sec.closest("#hero") ||
              sec.closest("[data-hero]")
            ) {
              sec.classList.remove(
                "scroll-reveal",
                "scroll-reveal-left",
                "scroll-reveal-right",
                "scroll-reveal-bottom",
              );
              sec.classList.add("is-revealed");
              return;
            }

            var rect = sec.getBoundingClientRect();

            // Reveal any sections already present in initial viewport immediately
            if (rect.top < windowHeight * 0.88) {
              sec.classList.add("scroll-reveal", "is-revealed");
              return;
            }

            // Directional entrance: custom data attribute or alternating left/right
            var customDir = sec.getAttribute("data-reveal-direction");
            var dirClass = customDir
              ? "scroll-reveal-" + customDir
              : revealIndex % 2 === 0
                ? "scroll-reveal-left"
                : "scroll-reveal-right";
            revealIndex++;

            sec.classList.add("scroll-reveal", dirClass);
            observer.observe(sec);
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initScrollReveal);
        } else {
          initScrollReveal();
        }

        window.addEventListener("load", initScrollReveal);
        setTimeout(initScrollReveal, 300);
      })();
    </script>
  </body>
