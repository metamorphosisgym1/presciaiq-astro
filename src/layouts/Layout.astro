    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // Islands hydrate after load and the first paint (client:paint). Hero reveal targets stay hidden until
      // SmoothScroll starts their fade, so they never show, vanish and fade back in. Safety: 5s.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-pending');
        setTimeout(function () { document.documentElement.classList.remove('reveal-pending'); }, 5000);
      }
    </script>
