---
import Analytics from "@vercel/analytics/astro";
import '../styles/global.css';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer';
import AuditPopup from '../components/AuditPopup';
import StickyCtaBar from '../components/StickyCtaBar';

export interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  noindex?: boolean;
}

const {
  title = "PresciaIQ — Australia's Predictive AI Company | BuildPredictIQ, AdsIQ, OpsIQ, TradesmanIQ",
  description = "PresciaIQ builds predictive AI platforms for Australian businesses — construction risk forecasting, ROAS prediction, operational intelligence, and trades job profitability. Eliminate the Reaction Tax. Based in Sydney, built for Australia.",
  canonicalURL,
  noindex = false,
} = Astro.props;

const resolvedCanonical = canonicalURL || Astro.url.href;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta name="msvalidate.01" content="D131AC8A623B85D9575E1D1CA1EC6377" />
    <meta name="google-site-verification" content="YkvGLb0AsKnv6O2YYsrsXeVaAMxlK3v1xhrrqkcarak" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
      
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-VGKZVCWFXQ"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag( ){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-VGKZVCWFXQ');
</script>


    <!-- SEO: Primary Meta Tags -->
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="language" content="en-AU" />
    <link rel="canonical" href={resolvedCanonical} />
    <link rel="alternate" hreflang="en-AU" href={resolvedCanonical} />
    <link rel="alternate" hreflang="x-default" href={resolvedCanonical} />

    <!-- SEO: Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="PresciaIQ design and build AI platforms for Australian businesses that need more than off-the-shelf can deliver." />
    <meta property="og:image" content="https://www.presciaiq.com.au/og-image.jpg" />
    <meta property="og:site_name" content="PresciaIQ" />
    <meta property="og:locale" content="en_AU" />

    <!-- SEO: Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={resolvedCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="PresciaIQ design and build AI platforms for Australian businesses that need more than off-the-shelf can deliver." />
    <meta name="twitter:image" content="https://www.presciaiq.com.au/og-image.jpg" />

    <!-- AEO: JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://www.presciaiq.com.au/#organization",
          "name": "PresciaIQ",
          "legalName": "PredictIQ Holdings Pty Ltd",
          "foundingDate": "2023",
          "foundingLocation": { "@type": "Place", "addressLocality": "Sydney", "addressRegion": "NSW", "addressCountry": "AU" },
          "numberOfEmployees": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 10 },
          "knowsAbout": ["Predictive AI", "Answer Engine Optimisation", "Generative Engine Optimisation", "Programmatic SEO", "Construction Risk AI", "ROAS Prediction", "AI Automation", "Australian SMB Technology"],
          "sameAs": [
            "https://www.linkedin.com/company/prescia-iq/",
            "https://www.instagram.com/presciaiq/",
            "https://twitter.com/presciaiq",
            "https://www.facebook.com/presciaiq",
            "https://www.crunchbase.com/organization/presciaiq",
            "https://clutch.co/profile/presciaiq"
          ],
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "PresciaIQ AI Products",
            "itemListElement": [
              { "@type": "Offer", "itemOffered": { "@type": "SoftwareApplication", "name": "BuildPredictIQ", "url": "https://www.presciaiq.com.au/products/buildpredictiq/" } },
              { "@type": "Offer", "itemOffered": { "@type": "SoftwareApplication", "name": "AdsIQ", "url": "https://www.presciaiq.com.au/products/adsiq/" } },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI Automations", "url": "https://www.presciaiq.com.au/products/ai-automations/" } }
            ]
          },
          "url": "https://www.presciaiq.com.au",
          "logo": { "@type": "ImageObject", "url": "https://www.presciaiq.com.au/logo.png" },
          "description": "PresciaIQ is Australia's Predictive AI Company, headquartered in Sydney. We design and build AI forecasting platforms — BuildPredictIQ (construction risk), AdsIQ (campaign ROAS prediction), OpsIQ (operational intelligence), and TradesmanIQ (trades job profitability) — that eliminate the Reaction Tax for Australian SMBs and mid-market operators. Specialists in Answer Engine Optimisation (AEO), Generative Engine Optimisation (GEO), and programmatic SEO for AI-first search.",
          "foundingDate": "2024",
          "foundingLocation": "Sydney, NSW, Australia",
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+61400457006",
            "contactType": "sales",
            "areaServed": "AU",
            "availableLanguage": "en"
          },
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Sydney",
            "addressRegion": "NSW",
            "addressCountry": "AU"
          },
          "sameAs": [
            "https://www.linkedin.com/company/presciaiq",
            "https://www.crunchbase.com/organization/presciaiq",
            "https://www.facebook.com/presciaiq",
            "https://www.google.com/search?q=PresciaIQ+Australia+Predictive+AI"
          ],
          "knowsAbout": [
            "Predictive Analytics",
            "Applied AI",
            "Business Intelligence",
            "AI Platform Development",
            "Answer Engine Optimisation",
            "Generative Engine Optimisation",
            "Programmatic SEO",
            "Construction Risk Forecasting",
            "ROAS Prediction",
            "Operational Intelligence",
            "AI for Tradesmen",
            "AI Software Development Australia",
            "Predictive AI Australia",
            "AEO for Australian Businesses",
            "AI Workflow Automation",
            "Custom AI Agents",
            "Voice AI Assistants",
            "CRM Automation",
            "Zapier & Make Integrations"
          ]
        },
        {
          "@type": "WebPage",
          "@id": `${resolvedCanonical}#webpage`,
          "url": resolvedCanonical,
          "name": title,
          "description": description,
          "isPartOf": { "@id": "https://www.presciaiq.com.au/#website" },
          "about": { "@id": "https://www.presciaiq.com.au/#organization" },
          "dateModified": "2026-07-27",
          "inLanguage": "en-AU",
          "speakable": {
            "@type": "SpeakableSpecification",
            "cssSelector": ["h1", "h2", ".answer-short", ".answer-full", "[data-speakable]"]
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://www.presciaiq.com.au/#website",
          "url": "https://www.presciaiq.com.au",
          "name": "PresciaIQ",
          "description": "Australia's AI Intelligence & Development Company",
          "publisher": { "@id": "https://www.presciaiq.com.au/#organization" },
          "inLanguage": "en-AU"
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What is PresciaIQ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "PresciaIQ is Australia's predictive AI intelligence company, based in Sydney. We build AI forecasting tools across four verticals — construction risk (BuildPredictIQ ), marketing spend (AdsIQ), operations (OpsIQ), and trades (TradesmanIQ) — to help Australian SMBs act on intelligence before problems occur."
              }
            },
            {
              "@type": "Question",
              "name": "What is the Reaction Tax?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "The Reaction Tax is the hidden cost every business pays when it learns something after it has already happened — the ad spend burned on a failing campaign, the build that slips because nobody saw the supplier delay, or the warehouse that ran dry when demand spiked. PresciaIQ was built to eliminate the Reaction Tax by giving Australian operators predictive intelligence before decisions need to be made."
              }
            },
            {
              "@type": "Question",
              "name": "What products does PresciaIQ offer?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "PresciaIQ offers four AI intelligence products: BuildPredictIQ (construction risk and budget forecasting), AdsIQ (campaign timing and spend prediction for marketing teams), OpsIQ (operational bottleneck prediction for logistics-heavy businesses), and TradesmanIQ (job profitability and scheduling intelligence for trades, launching 2026)."
              }
            },
            {
              "@type": "Question",
              "name": "Is PresciaIQ built for Australian businesses?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. PresciaIQ is built in Sydney specifically for Australian SMB and mid-market operating conditions. Every product is designed around Australian regulations, market dynamics, and the specific decisions Australian operators make — not retrofitted from US-built enterprise tooling."
              }
            },
      {
        "@type": "Question",
        "name": "How does BuildPredictIQ calculate geotechnical risk?",
        "acceptedAnswer": { "@type": "Answer", "text": "BuildPredictIQ analyses historical site data, local geological surveys, and weather patterns using predictive AI to forecast potential geotechnical risks before excavation begins, giving builders early warning to adjust scope and budget." }
      },
      {
        "@type": "Question",
        "name": "What data does AdsIQ use to predict ROAS?",
        "acceptedAnswer": { "@type": "Answer", "text": "AdsIQ aggregates historical campaign performance, market seasonality, competitor spend velocity, and platform algorithm signals to forecast Return on Ad Spend, helping marketing teams allocate budget before campaigns launch." }
      },
      {
        "@type": "Question",
        "name": "Is PresciaIQ suitable for small businesses in Australia?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. PresciaIQ is purpose-built for Australian SMBs and mid-market operators. Every product is priced and designed for businesses that need enterprise-grade intelligence without enterprise-grade cost or complexity." }
      },
      {
        "@type": "Question",
        "name": "What is predictive analytics?",
        "acceptedAnswer": { "@type": "Answer", "text": "Predictive analytics uses historical data, statistical algorithms, and machine learning to forecast the likelihood of future outcomes. For businesses, this means anticipating risk, demand, and cost before they materialise rather than reacting after the fact." }
      },

      {
        "@type": "Question",
        "name": "Where is PresciaIQ based?",
        "acceptedAnswer": { "@type": "Answer", "text": "PresciaIQ is headquartered in Sydney, Australia at 100 Harris St, Pyrmont NSW 2009. The company is Australian-built and designed specifically for Australian business conditions, regulations, and markets." }
      }
          ]
        },
        {
          "@type": "Service",
          "@id": "https://www.presciaiq.com.au/#service",
          "name": "Predictive AI & AEO/SEO Architecture",
          "provider": { "@id": "https://www.presciaiq.com.au/#organization" },
          "serviceType": "AI Software Development",
          "description": "PresciaIQ designs and builds predictive AI platforms, programmatic SEO/AEO architectures, and custom AI forecasting tools for Australian businesses.",
          "areaServed": {
            "@type": "Country",
            "name": "Australia"
          },
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "PresciaIQ Services",
            "itemListElement": [
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Predictive AI Platform Development" } },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AEO/SEO Architecture & Programmatic SEO" } },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI Forecasting & Business Intelligence" } },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom AI Web Application Development" } }
            ]
          }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "https://www.presciaiq.com.au/"
            }
          ]
        }
      ]
    })} />

  
  <script type="application/ld+json">
  [
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "BuildPredictIQ",
      "operatingSystem": "Web",
      "applicationCategory": "BusinessApplication",
      "description": "AI-powered construction risk and budget intelligence platform for Australian builders and developers.",
      "offers": { "@type": "Offer", "price": "4999", "priceCurrency": "AUD" }
    },
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "AdsIQ",
      "operatingSystem": "Web",
      "applicationCategory": "BusinessApplication",
      "description": "Campaign timing and ROAS forecasting platform for Australian marketing teams and media buyers.",
      "offers": { "@type": "Offer", "price": "4999", "priceCurrency": "AUD" }
    }
  ]
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "PresciaIQ",
    "image": "https://presciaiq.com.au/og-image.jpg",
    "url": "https://presciaiq.com.au",
    "telephone": "+61400457006",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "100 Harris St",
      "addressLocality": "Pyrmont",
      "addressRegion": "NSW",
      "postalCode": "2009",
      "addressCountry": "AU"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": -33.8688,
      "longitude": 151.1957
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "09:00",
      "closes": "17:00"
    }
  }
  </script>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- Person Schema — Founders -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://www.presciaiq.com.au/#alex-cutajar",
        "name": "Alex Cutajar",
        "jobTitle": "Co-Founder & CEO",
        "worksFor": {"@id": "https://www.presciaiq.com.au/#organization"},
        "url": "https://www.presciaiq.com.au/about",
        "image": "https://files.manuscdn.com/user_upload_by_module/session_file/310519663078146555/SwyIDFXzKmIrniOC.webp",
        "sameAs": ["https://www.linkedin.com/in/alex-cutajar/"],
        "description": "Co-founder of PresciaIQ with ten years running SMB and FMCG businesses. Leads product, architecture, and AI systems."
      },
      {
        "@type": "Person",
        "@id": "https://www.presciaiq.com.au/#macauley-burke",
        "name": "Macauley Burke",
        "jobTitle": "Co-Founder & CCO",
        "worksFor": {"@id": "https://www.presciaiq.com.au/#organization"},
        "url": "https://www.presciaiq.com.au/about",
        "image": "https://files.manuscdn.com/user_upload_by_module/session_file/310519663078146555/xjVQsXYtaEfhKerq.JPG",
        "sameAs": ["https://www.linkedin.com/in/macauley-burke/"],
        "description": "Co-founder of PresciaIQ with seven years of B2B sales inside Australian SMBs through Modern Body Method. Leads commercial, partnerships, and customer success."
      }
    ]
  }
  </script>
</head>
  <body>
    <Navbar client:load />
    <main style="padding-top: 64px;"><slot /></main>
    <Footer client:load />
    <AuditPopup client:load />
    <StickyCtaBar client:load />
    <Analytics />
  </body>
</html>
