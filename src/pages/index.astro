---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/sections/HeroSection';
import LogoMarquee from '../components/LogoMarquee';
import LiquidDivider from '../components/LiquidDivider';
import ParticleSwing from '../components/ParticleSwing';
import ProductsSection from '../components/sections/ProductsSection';
import AppBuildingSection from '../components/sections/AppBuildingSection';
import WhySection from '../components/sections/WhySection';
import LeadCaptureSection from '../components/sections/LeadCaptureSection';
// Same sections and order as components/App.tsx, but each is its own island:
// the hero wakes right after the first paint (visible), the rest as they come near,
// so a phone never runs every section's script at once on load.
const near = { rootMargin: '200px' };
---
<Layout title="PresciaIQ | Australia's Predictive AI Company">
  <HeroSection client:visible />
  <LogoMarquee client:visible={near} />
  <div class="relative">
    {/* White ink rises out of the marquee into the light Engines section. */}
    <LiquidDivider client:visible={near} className="h-[50vh] min-h-[300px] max-h-[520px]" />
    <ProductsSection client:visible={near} />
    {/* Dark particle swarm swinging across the white as the Engines section arrives. */}
    <ParticleSwing client:visible={near} trigger="products" className="z-20" />
  </div>
  <AppBuildingSection client:visible={near} showCaseStudy={false} featured />
  <LiquidDivider client:visible={near} className="h-[50vh] min-h-[300px] max-h-[520px]" />
  <WhySection client:visible={near} />
  <LiquidDivider client:visible={near} variant="light-to-dark" className="h-[50vh] min-h-[300px] max-h-[520px]" />
  <LeadCaptureSection client:visible={near} />
</Layout>
