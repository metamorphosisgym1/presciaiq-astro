---
import Layout from '../../layouts/Layout.astro';

const title = "BuildPredictIQ — AI Construction Risk & Cost Forecasting | PresciaIQ";
const description = "BuildPredictIQ predicts construction project cost overruns, timeline blowouts, and subcontractor risk before a sod is turned. Trained on 12,000+ Australian construction projects. Integrates with Procore and Aconex.";
const canonicalURL = new URL("/products/buildpredictiq/", Astro.site).href;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "BuildPredictIQ",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": description,
      "url": canonicalURL,
      "offers": {
        "@type": "Offer",
        "price": "1200",
        "priceCurrency": "AUD",
        "priceSpecification": { "@type": "UnitPriceSpecification", "price": "1200", "priceCurrency": "AUD", "unitText": "MONTH" }
      },
      "publisher": { "@type": "Organization", "name": "PresciaIQ", "url": "https://www.presciaiq.com.au" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.presciaiq.com.au/" },
        { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://www.presciaiq.com.au/products/" },
        { "@type": "ListItem", "position": 3, "name": "BuildPredictIQ", "item": canonicalURL }
      ]
    },
    { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".speakable-summary"] }
  ]
};
---

<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="min-h-screen bg-background text-foreground">
    <div class="border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <nav class="flex items-center gap-2 text-sm text-muted-foreground font-sans flex-wrap">
          <a href="/" class="hover:text-primary transition-colors">Home</a>
          <span>/</span>
          <a href="/products/" class="hover:text-primary transition-colors">Products</a>
          <span>/</span>
          <span class="text-foreground">BuildPredictIQ</span>
        </nav>
      </div>
    </div>

    <section class="py-16 md:py-24 border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-3 mb-6">
          <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold text-primary border border-primary/20 bg-primary/5">BuildPredictIQ</span>
          <span class="text-xs text-muted-foreground font-sans">Construction & Property</span>
        </div>
        <h1 class="font-display text-4xl md:text-6xl font-bold text-foreground mb-6 leading-tight max-w-4xl">
          The Prediction Engine That Stops <span class="text-gradient-primary">Construction Cost Blowouts</span>
        </h1>
        <p class="speakable-summary text-lg text-muted-foreground font-sans max-w-2xl leading-relaxed mb-8">
          BuildPredictIQ analyses 47 risk variables — weather, subcontractor history, material lead times, council approval timelines, and site complexity — to produce a risk-adjusted cost forecast before you commit to a project.
        </p>
        <div class="flex flex-col sm:flex-row items-start gap-6 mb-8">
          <a href="/start/" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-primary text-primary-foreground font-semibold text-sm font-sans hover:shadow-[0_0_20px_rgba(0,255,136,0.3)] transition-all duration-500">
            Start Free Risk Assessment →
          </a>
          <div>
            <p class="text-xs text-muted-foreground font-sans mb-1">Starting from</p>
            <p class="font-mono text-2xl font-bold text-primary">$1,200/month</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {[
            { stat: "23%", label: "Average cost overrun reduction" },
            { stat: "12,000+", label: "Australian projects in training data" },
            { stat: "47", label: "Risk variables per project" },
            { stat: "89%", label: "Forecast accuracy on 3-month horizon" },
          ].map(item => (
            <div class="rounded-xl p-6 border border-white/8" style="background: rgba(255,255,255,0.02);">
              <p class="font-mono text-3xl font-bold text-primary mb-2">{item.stat}</p>
              <p class="text-sm text-muted-foreground font-sans leading-snug">{item.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-xs uppercase tracking-[0.25em] text-primary font-sans font-semibold mb-4">Features</p>
        <h2 class="font-display text-3xl font-bold text-foreground mb-10">What BuildPredictIQ Does</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {[
            {
              title: "Cost Overrun Prediction",
              desc: "Produces a risk-adjusted cost forecast with confidence intervals based on your project parameters and 12,000+ comparable Australian projects."
            },
            {
              title: "Timeline Confidence Intervals",
              desc: "Predicts project completion date with a P50/P80/P90 confidence range, factoring in weather, council approval history for your LGA, and subcontractor availability."
            },
            {
              title: "Subcontractor Risk Scoring",
              desc: "Scores each subcontractor against their payment history, completion rate, and defect frequency from your historical project data and industry records."
            },
            {
              title: "Procore & Aconex Integration",
              desc: "Native bidirectional integration — project data flows in from your PM software, and risk predictions flow back into the project record automatically."
            },
            {
              title: "Tender Pricing Intelligence",
              desc: "Helps you price tenders with confidence by showing the margin risk profile of each project before you submit — so you win the right jobs, not just the most jobs."
            },
            {
              title: "Material Price Monitoring",
              desc: "Tracks real-time Australian material pricing (steel, timber, concrete, copper) and alerts you when a price movement materially affects your project forecast."
            },
          ].map(f => (
            <div class="rounded-xl border border-white/8 p-6" style="background: rgba(255,255,255,0.02);">
              <h3 class="font-display text-lg font-bold text-foreground mb-3">{f.title}</h3>
              <p class="text-muted-foreground font-sans text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-xs uppercase tracking-[0.25em] text-primary font-sans font-semibold mb-4">Related</p>
        <div class="grid sm:grid-cols-3 gap-4">
          <a href="/industries/construction/" class="rounded-xl border border-white/8 p-5 hover:border-primary/30 transition-all" style="background: rgba(255,255,255,0.02);">
            <p class="font-mono text-xs text-primary mb-2">Industry</p>
            <p class="font-display font-bold text-foreground">Construction & Property →</p>
          </a>
          <a href="/insights/case-studies/buildhire/" class="rounded-xl border border-white/8 p-5 hover:border-primary/30 transition-all" style="background: rgba(255,255,255,0.02);">
            <p class="font-mono text-xs text-primary mb-2">Case Study</p>
            <p class="font-display font-bold text-foreground">BuildHire Case Study →</p>
          </a>
          <a href="/start/" class="rounded-xl border border-white/8 p-5 hover:border-primary/30 transition-all" style="background: rgba(255,255,255,0.02);">
            <p class="font-mono text-xs text-primary mb-2">Get Started</p>
            <p class="font-display font-bold text-foreground">Book Free Assessment →</p>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
