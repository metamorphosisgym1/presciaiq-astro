---
import Layout from '../../layouts/Layout.astro';
import ProductsHero from '../../components/sections/ProductsHero';
import LiquidDivider from '../../components/LiquidDivider';
import ProductsCatalog from '../../components/sections/ProductsCatalog';
import LeadCaptureSection from '../../components/sections/LeadCaptureSection';

const title = "Enterprise AI Products & Platforms | PresciaIQ";
const description = "High-performance predictive AI engines and autonomous platforms for Australian enterprise. BuildPredictIQ, AdsIQ, AI Automations & Agents, and HELM OS.";
const canonicalURL = new URL("/products/", Astro.site).href;

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "PresciaIQ Products & Platforms",
  "description": description,
  "url": canonicalURL,
  "publisher": { "@type": "Organization", "name": "PresciaIQ", "url": "https://www.presciaiq.com.au" },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.presciaiq.com.au/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": canonicalURL }
    ]
  }
};
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What AI products does PresciaIQ offer?",
      "acceptedAnswer": { "@type": "Answer", "text": "PresciaIQ offers four core predictive AI and autonomous platforms for Australian enterprise: BuildPredictIQ for construction risk and cost overrun prediction, AdsIQ for marketing campaign ROAS forecasting, AI Automations & Agents for autonomous workflow orchestration and document processing, and HELM OS for centralized enterprise operational intelligence." }
    },
    {
      "@type": "Question",
      "name": "How much do PresciaIQ AI products cost?",
      "acceptedAnswer": { "@type": "Answer", "text": "PresciaIQ products are calibrated to enterprise value: AdsIQ starts from $890/month, BuildPredictIQ starts from $2,500/report or annual subscription, and AI Automations & HELM OS are scoped based on organizational integration and workflow volume. Contact PresciaIQ for a tailored scoping assessment." }
    },
    {
      "@type": "Question",
      "name": "Are PresciaIQ products built for Australian businesses?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. All PresciaIQ products and platforms are trained on Australian data, built to Australian compliance standards (Privacy Act 1988 Cth, APP), and hosted 100% on Australian sovereign infrastructure (AWS Sydney ap-southeast-2). This ensures predictions and agent pipelines are calibrated to Australian market realities." }
    }
  ]
}
</script>

<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="relative w-full bg-[#050806] text-foreground overflow-x-hidden">
    <!-- 1. Hero Section (Deep obsidian background, radial mint glow, interactive dot grid) -->
    <ProductsHero client:load />

    <!-- 2. Liquid Drip Transition (Dark to Light: obsidian dripping into crisp white) -->
    <LiquidDivider client:load className="h-[40vh] min-h-[260px] max-h-[460px]" />

    <!-- 3. Core Product Catalog inside High-Contrast Crisp White Section -->
    <ProductsCatalog client:load />

    <!-- 4. Liquid Drip Transition (Light to Dark: crisp white dripping into obsidian dark) -->
    <LiquidDivider client:load variant="light-to-dark" className="h-[40vh] min-h-[260px] max-h-[460px]" />

    <!-- 5. Pre-Footer CTA Section (Particle vortex cloud & obsidian dark background) -->
    <LeadCaptureSection client:visible />
  </div>
</Layout>
