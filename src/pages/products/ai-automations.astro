---
import Layout from '../../layouts/Layout.astro';

const title = "AI Automations by PresciaIQ | Custom Workflows & Agents for Australian Businesses";
const description = "We build custom AI automations, agents, and workflows that eliminate manual data entry, streamline customer service, and connect your existing software stack. Project-based pricing for Australian businesses.";
const canonicalURL = new URL("/products/ai-automations/", Astro.site).href;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "AI Automations by PresciaIQ",
      "serviceType": "AI Workflow Automation",
      "description": description,
      "url": canonicalURL,
      "provider": { "@type": "Organization", "name": "PresciaIQ", "url": "https://www.presciaiq.com.au" },
      "areaServed": { "@type": "Country", "name": "Australia" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.presciaiq.com.au/" },
        { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://www.presciaiq.com.au/products/" },
        { "@type": "ListItem", "position": 3, "name": "AI Automations", "item": canonicalURL }
      ]
    }
  ]
};
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is AI Automations by PresciaIQ?",
      "acceptedAnswer": { "@type": "Answer", "text": "It is a standalone service where we build custom AI workflows, agents, and software integrations for your business. We connect your existing tools (CRM, email, accounting) and add AI capabilities to eliminate manual data entry, automate customer support, and streamline operations." }
    },
    {
      "@type": "Question",
      "name": "How is this priced?",
      "acceptedAnswer": { "@type": "Answer", "text": "We operate on a project-based pricing model. We scope the exact automation you need, quote a fixed project fee to build and deploy it, and hand it over. There are no ongoing retainers unless you specifically request ongoing maintenance or continuous expansion." }
    },
    {
      "@type": "Question",
      "name": "What software can you automate?",
      "acceptedAnswer": { "@type": "Answer", "text": "We can automate almost any modern software with an API. This includes HubSpot, Salesforce, Xero, Xero Practice Manager, ServiceM8, Simpro, Gmail, Outlook, Slack, Teams, and hundreds of others using platforms like Make.com, Zapier, or custom code." }
    }
  ]
}
</script>
<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="min-h-screen bg-background text-foreground">
    <div class="border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <nav class="flex items-center gap-2 text-sm text-muted-foreground font-sans flex-wrap">
          <a href="/" class="hover:text-primary transition-colors">Home</a>
          <span>/</span>
          <a href="/products/" class="hover:text-primary transition-colors">Products</a>
          <span>/</span>
          <span class="text-foreground">AI Automations</span>
        </nav>
      </div>
    </div>

    <section class="py-16 md:py-24 border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-3 mb-6">
          <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold text-primary border border-primary/20 bg-primary/5">AI Automations</span>
          <span class="text-xs text-muted-foreground font-sans">Custom Solutions</span>
        </div>
        <h1 class="font-display text-4xl md:text-6xl font-bold text-foreground mb-6 leading-tight max-w-4xl">
          Stop Doing Work <span class="text-gradient-primary">Software Can Do For You</span>
        </h1>
        <p class="speakable-summary text-lg text-muted-foreground font-sans max-w-2xl leading-relaxed mb-8">
          We build custom AI agents, voice assistants, and workflow automations that connect your existing software stack. Eliminate manual data entry, automate customer service, and scale your operations without scaling headcount.
        </p>
        <div class="flex flex-col sm:flex-row items-start gap-6 mb-8">
          <a href="/start/" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-primary text-primary-foreground font-semibold text-sm font-sans hover:shadow-[0_0_20px_rgba(0,255,136,0.3)] transition-all duration-500">
            Book a Scoping Call →
          </a>
          <div>
            <p class="text-xs text-muted-foreground font-sans mb-1">Pricing Model</p>
            <p class="font-mono text-xl font-bold text-primary">Fixed Project Fee</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {[
            { stat: "100+", label: "Software integrations supported" },
            { stat: "24/7", label: "Automated customer support" },
            { stat: "Zero", label: "Ongoing retainers required" },
            { stat: "10x", label: "Faster document processing" },
          ].map(item => (
            <div class="rounded-xl p-6 border border-white/8" style="background: rgba(255,255,255,0.02);">
              <p class="font-mono text-3xl font-bold text-primary mb-2">{item.stat}</p>
              <p class="text-sm text-muted-foreground font-sans leading-snug">{item.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-xs uppercase tracking-[0.25em] text-primary font-sans font-semibold mb-4">Capabilities</p>
        <h2 class="font-display text-3xl font-bold text-foreground mb-10">What We Can Automate</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {[
            { title: "CRM & Sales Automation", desc: "Automatically capture leads from your website or emails, enrich them with company data, assign them to the right sales rep, and trigger follow-up sequences in HubSpot or Salesforce." },
            { title: "Document Processing", desc: "Use AI to automatically extract data from PDFs, invoices, and contracts, and push the structured data directly into Xero, MYOB, or your ERP system without manual data entry." },
            { title: "AI Customer Support Agents", desc: "Deploy intelligent chatbots trained on your company's specific knowledge base, FAQs, and product manuals to answer customer questions 24/7." },
            { title: "Voice AI & Call Handling", desc: "Implement AI voice agents that can answer inbound calls, book appointments directly into your calendar, and answer common questions with natural-sounding speech." },
            { title: "Field Service Workflows", desc: "Connect ServiceM8, Simpro, or AroFlo to your accounting and CRM systems. Automate job scheduling, quote generation, and post-job follow-ups." },
            { title: "Custom Internal Tools", desc: "Need something specific? We build custom dashboards and internal tools that aggregate data from multiple systems into one clean interface for your team." },
          ].map(f => (
            <div class="rounded-xl border border-white/8 p-6" style="background: rgba(255,255,255,0.02);">
              <h3 class="font-display text-lg font-bold text-foreground mb-3">{f.title}</h3>
              <p class="text-muted-foreground font-sans text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-xs uppercase tracking-[0.25em] text-primary font-sans font-semibold mb-6">Related</p>
        <div class="grid sm:grid-cols-3 gap-4">
          <a href="/industries/trades/" class="rounded-xl border border-white/8 p-5 hover:border-primary/30 transition-all" style="background: rgba(255,255,255,0.02);">
            <p class="font-mono text-xs text-primary mb-2">Industry</p>
            <p class="font-display font-bold text-foreground">Trades & Field Services →</p>
          </a>
          <a href="/products/" class="rounded-xl border border-white/8 p-5 hover:border-primary/30 transition-all" style="background: rgba(255,255,255,0.02);">
            <p class="font-mono text-xs text-primary mb-2">Products</p>
            <p class="font-display font-bold text-foreground">All Products →</p>
          </a>
          <a href="/start/" class="rounded-xl border border-white/8 p-5 hover:border-primary/30 transition-all" style="background: rgba(255,255,255,0.02);">
            <p class="font-mono text-xs text-primary mb-2">Get Started</p>
            <p class="font-display font-bold text-foreground">Book Scoping Call →</p>
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Internal linking: related pages for SEO -->
  <section class="bg-[#0a0a0a] border-t border-[#1a1a1a] py-12 px-6">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-white text-xl font-bold mb-6">Explore Related Resources</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/insights/ai-automation-cost-australia-2026/" class="block p-4 bg-[#111] border border-[#222] rounded-lg hover:border-[#00ff88] transition-colors">
          <div class="text-[#00ff88] text-sm font-semibold mb-1">Blog</div>
          <div class="text-white font-medium">AI Automation Cost 2026</div>
          <div class="text-gray-400 text-sm mt-1">Complete pricing guide for AI automation in Australian businesses</div>
        </a>
        <a href="/answers/what-is-ai-automation-for-australian-business/" class="block p-4 bg-[#111] border border-[#222] rounded-lg hover:border-[#00ff88] transition-colors">
          <div class="text-[#00ff88] text-sm font-semibold mb-1">AI Answer</div>
          <div class="text-white font-medium">What is AI Automation?</div>
          <div class="text-gray-400 text-sm mt-1">The definitive guide to AI automation for Australian SMBs</div>
        </a>
        <a href="/insights/ai-automation-vs-zapier/" class="block p-4 bg-[#111] border border-[#222] rounded-lg hover:border-[#00ff88] transition-colors">
          <div class="text-[#00ff88] text-sm font-semibold mb-1">Comparison</div>
          <div class="text-white font-medium">AI Automation vs Zapier</div>
          <div class="text-gray-400 text-sm mt-1">When to use AI automation vs workflow tools like Zapier</div>
        </a>
        <a href="/reaction-tax-calculator/" class="block p-4 bg-[#111] border border-[#222] rounded-lg hover:border-[#00ff88] transition-colors">
          <div class="text-[#00ff88] text-sm font-semibold mb-1">Tool</div>
          <div class="text-white font-medium">Reaction Tax Calculator</div>
          <div class="text-gray-400 text-sm mt-1">Calculate your automation ROI potential</div>
        </a>
        <a href="/locations/sydney/" class="block p-4 bg-[#111] border border-[#222] rounded-lg hover:border-[#00ff88] transition-colors">
          <div class="text-[#00ff88] text-sm font-semibold mb-1">Location</div>
          <div class="text-white font-medium">AI Automation Sydney</div>
          <div class="text-gray-400 text-sm mt-1">AI automation services for Sydney businesses</div>
        </a>
        <a href="/case-studies/" class="block p-4 bg-[#111] border border-[#222] rounded-lg hover:border-[#00ff88] transition-colors">
          <div class="text-[#00ff88] text-sm font-semibold mb-1">Case Studies</div>
          <div class="text-white font-medium">Client Results</div>
          <div class="text-gray-400 text-sm mt-1">See how Australian businesses use PresciaIQ AI Automations</div>
        </a>
      </div>
    </div>
  </section>
</Layout>

