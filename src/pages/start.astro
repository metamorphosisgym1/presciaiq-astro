---
import Layout from '../layouts/Layout.astro';
import IntakeQuiz from '../components/sections/IntakeQuiz';
---
<Layout
  title="Start Your Project | PresciaIQ — 24hr Response"
  description="Tell us what you're building. Complete our 2-minute intake brief and PresciaIQ will respond within 24 hours with a tailored recommendation. Australia's Predictive AI Company."
>
  <main class="min-h-screen pt-12 pb-20 overflow-x-hidden">

    <!-- Page header -->
    <div class="w-full max-w-xl mx-auto px-4 mb-10">
      <p class="text-xs font-mono text-primary tracking-widest uppercase mb-3">Client Intake Brief</p>
      <h1 class="font-display text-3xl md:text-4xl font-bold text-white leading-tight mb-3">
        Intelligence that<br />moves first.
      </h1>
      <p class="text-sm text-white/60 font-sans leading-relaxed max-w-sm">
        A short brief so we walk into our first conversation already aligned — and ready to build. Takes 5–10 minutes.
      </p>

      <!-- AI capability statement -->
      <p class="mt-4 text-xs font-mono text-white/35 leading-relaxed max-w-sm">
        PresciaIQ builds anything AI — custom agents, predictive systems, AEO/SEO architecture, automation, SaaS platforms, and full-stack AI products. If it involves intelligence, we scope it.
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-mono text-white/40">
        <span>5–10 min</span>
        <span class="text-white/10 hidden sm:inline">|</span>
        <span>7 sections</span>
        <span class="text-white/10 hidden sm:inline">|</span>
        <span>Reply within 24 hrs</span>
      </div>
    </div>

    <!-- Thin divider -->
    <div class="w-full max-w-xl mx-auto px-4 mb-8">
      <div class="h-px bg-white/[0.06]"></div>
    </div>

    <!-- Quiz -->
    <IntakeQuiz client:load />

    <script>
      const offer = new URLSearchParams(window.location.search).get('offer');
      if (offer) {
        const originalFetch = window.fetch.bind(window);
        window.fetch = async (input, init) => {
          const requestUrl = typeof input === 'string'
            ? input
            : input instanceof Request
              ? input.url
              : String(input);

          if (requestUrl === 'https://api.web3forms.com/submit' && typeof init?.body === 'string') {
            try {
              const payload = JSON.parse(init.body);
              init = {
                ...init,
                body: JSON.stringify({
                  ...payload,
                  'Offer Interest': offer.slice(0, 120),
                  'Landing Page': window.location.href,
                }),
              };
            } catch {
              // Preserve the existing lead flow if a submission body is not JSON.
            }
          }

          return originalFetch(input, init);
        };
      }
    </script>

  </main>
</Layout>
