---
import Layout from '../layouts/Layout.astro';
import WhySection from '../components/sections/WhySection';
import LeadCaptureSection from '../components/sections/LeadCaptureSection';
---

<Layout title="About PresciaIQ | Australian AI Company" description="Meet the team behind PresciaIQ — Australia's predictive AI company. We build AI platforms that help SMBs act before problems happen, not after.">
  <script type="application/ld+json">
  [
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": "https://www.presciaiq.com.au/about/#alex-cutajar",
      "name": "Alex Cutajar",
      "jobTitle": "Co-Founder & CEO",
      "url": "https://www.presciaiq.com.au/about/",
      "worksFor": { "@type": "Organization", "@id": "https://www.presciaiq.com.au/#organization", "name": "PresciaIQ" },
      "description": "Alex Cutajar is a co-founder of PresciaIQ with a background in SMB and FMCG operations and applied AI. He leads product strategy and AI development at PresciaIQ.",
      "knowsAbout": ["Predictive Analytics", "AI Strategy", "SMB Operations", "Applied AI", "Business Intelligence", "FMCG"],
      "sameAs": [
        "https://www.linkedin.com/in/alex-cutajar",
        "https://www.presciaiq.com.au/about/"
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": "https://www.presciaiq.com.au/about/#macauley-burke",
      "name": "Macauley Burke",
      "jobTitle": "Co-Founder & Head of Growth",
      "url": "https://www.presciaiq.com.au/about/",
      "worksFor": { "@type": "Organization", "@id": "https://www.presciaiq.com.au/#organization", "name": "PresciaIQ" },
      "description": "Macauley Burke is a co-founder of PresciaIQ with a background in B2B sales and enterprise client development. He leads growth and commercial strategy at PresciaIQ.",
      "knowsAbout": ["B2B Sales", "Enterprise Client Development", "AI Commercialisation", "Revenue Growth", "Marketing Strategy"],
      "sameAs": [
        "https://www.linkedin.com/in/macauley-burke",
        "https://www.presciaiq.com.au/about/"
      ]
    }
  ]
  </script>
  <h1 class="font-display text-4xl md:text-5xl font-bold text-foreground mb-8 text-center">About PresciaIQ — Australian AI Intelligence Company</h1>
  <div class="pt-12">
    <WhySection client:load />
    <LeadCaptureSection client:load />
    <div class="mt-4 text-sm text-muted-foreground font-sans">
      <strong class="text-foreground">Sydney Office</strong>  

      100 Harris St, Pyrmont NSW 2009, Australia
    </div>
  </div>
</Layout>
