---
import Layout from '../../../../../layouts/Layout.astro';
import { servicesData } from '../../../../../data/services-data';
import { industries } from '../../../../../data/industries';
import { locations } from '../../../../../data/locations';
import { problems } from '../../../../../data/problems';

export function getStaticPaths() {
  const paths = [];
  for (const service of servicesData) {
    for (const industry of industries) {
      // Find problems specific to this industry
      const industryProblems = problems.filter(p => p.industrySlug === industry.slug);
      
      for (const location of locations) {
        for (const problem of industryProblems) {
          paths.push({
            params: { 
              service: service.slug,
              industry: industry.slug,
              location: location.slug,
              problem: problem.slug
            },
            props: { service, industry, location, problem },
          });
        }
      }
    }
  }
  return paths;
}

const { service, industry, location, problem } = Astro.props;

const title = `Solving ${problem.problemShort} for ${industry.plural} in ${location.name} | PresciaIQ`;
const description = `Discover how ${location.name} ${industry.name.toLowerCase()} businesses use ${service.name.toLowerCase()} to predict and prevent ${problem.problemShort.toLowerCase()} before it impacts operations.`;
const canonicalURL = `https://www.presciaiq.com.au/solutions/${service.slug}/${industry.slug}/${location.slug}/${problem.slug}`;
const parentURL = `https://www.presciaiq.com.au/solutions/${service.slug}/${industry.slug}/${location.slug}`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.presciaiq.com.au" },
    { "@type": "ListItem", "position": 2, "name": "Solutions", "item": "https://www.presciaiq.com.au/solutions" },
    { "@type": "ListItem", "position": 3, "name": service.name, "item": `https://www.presciaiq.com.au/services/${service.slug}` },
    { "@type": "ListItem", "position": 4, "name": `${industry.name} ${location.name}`, "item": parentURL },
    { "@type": "ListItem", "position": 5, "name": problem.problemShort, "item": canonicalURL }
  ]
};


const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  'name': 'PresciaIQ ' + service.name,
  'applicationCategory': 'BusinessApplication',
  'operatingSystem': 'Web, Cloud',
  'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'AUD' },
  'description': 'Predictive AI software designed to solve ' + problem.problemShort.toLowerCase() + ' for ' + industry.plural + ' in ' + location.name + '.'
};
const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': title,
  'speakable': { '@type': 'SpeakableSpecification', 'xpath': ['/html/head/title', '/html/head/meta[@name=description]/@content'] },
  'url': canonicalURL
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": problem.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout title={title} description={description}>
  <div class="pt-32 pb-24 min-h-screen">
    <div class="max-w-3xl mx-auto px-6">
      
      <div class="glass-card p-8 md:p-12 border border-[#00ff88]/20">
        <div class="flex flex-wrap gap-4 mb-6 text-sm text-gray-400 font-sans">
          <span class="text-[#00ff88] font-semibold uppercase tracking-widest text-xs">{industry.name}</span>
          <span class="text-white/70 font-semibold uppercase tracking-widest text-xs">{location.name}</span>
          <span>&bull; {service.shortName}</span>
        </div>

        <h1 class="font-display text-3xl md:text-4xl font-bold text-white mb-8 leading-tight">
          Solving {problem.problemShort} for {industry.plural} {location.preposition} {location.name}
        </h1>
        
        <p class="text-xl text-gray-400 mb-10 font-medium leading-relaxed">
          How {location.name} businesses use {service.name.toLowerCase()} to predict and prevent {problem.problemShort.toLowerCase()} before it impacts operations.
        </p>
        
        <div class="prose prose-invert prose-lg max-w-none font-sans text-gray-400 leading-relaxed">
          
          <h2 class="font-display text-2xl font-bold text-white mt-10 mb-4">The Problem</h2>
          <div class="bg-black/40 border-l-4 border-red-500/50 p-6 mb-8 rounded-r-lg">
            <p class="mb-4"><strong>The Symptom:</strong> {problem.symptom}</p>
            <p class="mb-4"><strong>The Root Cause:</strong> {problem.rootCause}</p>
            <p class="text-white"><strong>The Cost:</strong> {problem.cost}</p>
          </div>

          <h2 class="font-display text-2xl font-bold text-white mt-10 mb-4">The {service.shortName} Solution</h2>
          <div class="bg-black/40 border-l-4 border-[#00ff88] p-6 mb-8 rounded-r-lg">
            <p class="mb-4"><strong>How It Works:</strong> {problem.solution}</p>
            <p class="text-white"><strong>The Outcome:</strong> {problem.outcome}</p>
          </div>

          <h2 class="font-display text-2xl font-bold text-white mt-12 mb-6">Frequently Asked Questions</h2>
          <div class="space-y-8 mb-12">
            {problem.faqs.map(faq => (
              <div>
                <h3 class="font-display text-xl font-semibold text-white mb-3">{faq.q}</h3>
                <p>{faq.a}</p>
              </div>
            ))}
          </div>

          <div class="mt-12 pt-8 border-t border-white/10">
            <div class="bg-gradient-to-r from-[#00ff88]/20 to-transparent p-8 rounded-xl border border-[#00ff88]/30">
              <h3 class="text-2xl font-bold text-white mb-4">Stop reacting. Start predicting.</h3>
              <p class="text-gray-300 mb-6">Learn how PresciaIQ can help your {location.name} {industry.name.toLowerCase()} business eliminate the Reaction Tax and predict {problem.problemShort.toLowerCase()} before it happens.</p>
              <div class="flex flex-wrap gap-4">
                <a href="/contact" class="inline-block bg-[#00ff88] text-black font-bold px-8 py-4 rounded-lg hover:bg-[#00ff88]/90 transition-colors">
                  Book a Strategy Call
                </a>
                <a href={parentURL} class="inline-block bg-transparent text-white border border-white/20 font-bold px-8 py-4 rounded-lg hover:bg-white/5 transition-colors">
                  Back to {industry.name} Overview
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />
</Layout>
