---
import Layout from '../layouts/Layout.astro';

const title = "Predictive ROI Calculator — Operational Drag & Latency Assessment | PresciaIQ";
const description = "Calculate your business's annual operational drag and latency penalty — the hidden cost of making decisions without predictive intelligence. Free calculator for Australian businesses.";
const canonicalURL = "/reaction-tax-calculator/";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Predictive ROI Calculator",
  "description": description,
  "url": `https://www.presciaiq.com.au${canonicalURL}`,
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "AUD" },
  "publisher": { "@type": "Organization", "name": "PresciaIQ", "url": "https://www.presciaiq.com.au" }
};
---

<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="min-h-screen bg-background text-[#F0EDE6] pt-28 pb-24 relative overflow-x-hidden">
    <!-- Ambient: top-right mint radial glow -->
    <div
      class="pointer-events-none fixed inset-0 z-0 bg-[radial-gradient(ellipse_at_top_right,rgba(0,255,136,0.12),transparent_60%)]"
      aria-hidden="true"
    ></div>

    <!-- Subtle intelligence grid backdrop -->
    <div
      class="pointer-events-none fixed inset-0 z-0 grid-overlay opacity-60"
      aria-hidden="true"
    ></div>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <!-- Breadcrumb -->
      <nav class="flex justify-center items-center gap-2 text-xs font-mono text-[#8FAF8F] mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#00FF88] transition-colors">Home</a>
        <span class="text-white/20">/</span>
        <a href="/pricing/" class="hover:text-[#00FF88] transition-colors">Pricing</a>
        <span class="text-white/20">/</span>
        <span class="text-[#F0EDE6]">ROI Calculator</span>
      </nav>

      <!-- Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-white/10 bg-white/[0.04] text-xs font-mono uppercase tracking-[0.2em] text-[#00FF88] mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00FF88] shadow-[0_0_8px_#00FF88]"></span>
          ROI QUANTIFICATION // FREE TOOL
        </div>
        <h1 class="font-serif text-4xl md:text-5xl font-semibold text-[#F0EDE6] mt-2 mb-4 leading-tight">
          Quantify Your<br /><span class="text-[#00FF88] italic">Operational Drag &amp; Potential ROI</span>
        </h1>
        <p class="text-base text-[#C9CCC8] font-sans max-w-xl mx-auto leading-relaxed">
          Operational drag is the cumulative cost an enterprise incurs when operating on lagging indicators. Calculate your unrecovered EBITDA and projected PresciaIQ ROI in 60 seconds.
        </p>
      </div>

      <!-- Calculator Card -->
      <div class="rounded-3xl border border-white/10 bg-[#111411]/90 backdrop-blur-2xl p-8 md:p-10 shadow-2xl relative overflow-hidden" id="calculator">
        <div class="pointer-events-none absolute -top-24 right-0 w-80 h-80 rounded-full bg-[radial-gradient(circle,rgba(0,255,136,0.08),transparent_70%)]"></div>

        <!-- Step 1: Industry -->
        <div class="mb-8 relative z-10" id="step-industry">
          <label class="block text-xs font-mono font-semibold text-[#00FF88] mb-3 uppercase tracking-wider">1. Your Industry</label>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3" id="industry-grid">
            <button onclick="selectIndustry(this, 0.18)" data-rate="0.18" class="industry-btn px-4 py-3 rounded-xl border border-white/10 text-xs font-mono text-[#C9CCC8] hover:border-[#00FF88]/50 hover:text-white transition-all text-left bg-white/[0.02]">Construction & Property</button>
            <button onclick="selectIndustry(this, 0.22)" data-rate="0.22" class="industry-btn px-4 py-3 rounded-xl border border-white/10 text-xs font-mono text-[#C9CCC8] hover:border-[#00FF88]/50 hover:text-white transition-all text-left bg-white/[0.02]">Marketing & Acquisition</button>
            <button onclick="selectIndustry(this, 0.15)" data-rate="0.15" class="industry-btn px-4 py-3 rounded-xl border border-white/10 text-xs font-mono text-[#C9CCC8] hover:border-[#00FF88]/50 hover:text-white transition-all text-left bg-white/[0.02]">Retail & E-commerce</button>
            <button onclick="selectIndustry(this, 0.20)" data-rate="0.20" class="industry-btn px-4 py-3 rounded-xl border border-white/10 text-xs font-mono text-[#C9CCC8] hover:border-[#00FF88]/50 hover:text-white transition-all text-left bg-white/[0.02]">Professional Services</button>
            <button onclick="selectIndustry(this, 0.17)" data-rate="0.17" class="industry-btn px-4 py-3 rounded-xl border border-white/10 text-xs font-mono text-[#C9CCC8] hover:border-[#00FF88]/50 hover:text-white transition-all text-left bg-white/[0.02]">Logistics & Supply Chain</button>
            <button onclick="selectIndustry(this, 0.19)" data-rate="0.19" class="industry-btn px-4 py-3 rounded-xl border border-white/10 text-xs font-mono text-[#C9CCC8] hover:border-[#00FF88]/50 hover:text-white transition-all text-left bg-white/[0.02]">Health & Wellness</button>
            <button onclick="selectIndustry(this, 0.16)" data-rate="0.16" class="industry-btn px-4 py-3 rounded-xl border border-white/10 text-xs font-mono text-[#C9CCC8] hover:border-[#00FF88]/50 hover:text-white transition-all text-left bg-white/[0.02]">Hospitality & Food</button>
            <button onclick="selectIndustry(this, 0.21)" data-rate="0.21" class="industry-btn px-4 py-3 rounded-xl border border-white/10 text-xs font-mono text-[#C9CCC8] hover:border-[#00FF88]/50 hover:text-white transition-all text-left bg-white/[0.02]">Technology & SaaS</button>
            <button onclick="selectIndustry(this, 0.18)" data-rate="0.18" class="industry-btn px-4 py-3 rounded-xl border border-white/10 text-xs font-mono text-[#C9CCC8] hover:border-[#00FF88]/50 hover:text-white transition-all text-left bg-white/[0.02]">Enterprise Operations</button>
          </div>
        </div>

        <!-- Step 2: Revenue -->
        <div class="mb-8 relative z-10">
          <label class="block text-xs font-mono font-semibold text-[#00FF88] mb-3 uppercase tracking-wider">2. Annual Revenue (AUD)</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#8FAF8F] font-mono">$</span>
            <input type="number" id="revenue-input" placeholder="2,000,000" min="100000" max="100000000" step="100000"
              class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-4 py-3 pl-8 text-[#F0EDE6] font-mono text-lg focus:outline-none focus:border-[#00FF88]/60 transition-colors"
              oninput="calculateTax()" />
          </div>
          <p class="text-xs text-[#8FAF8F] font-sans mt-2">Enter your approximate annual turnover in Australian dollars</p>
        </div>

        <!-- Step 3: Team size -->
        <div class="mb-10 relative z-10">
          <label class="block text-xs font-mono font-semibold text-[#00FF88] mb-3 uppercase tracking-wider">3. Team Size</label>
          <div class="grid grid-cols-4 gap-3">
            <button onclick="selectTeam(this, 1.0)" class="team-btn px-3 py-3 rounded-xl border border-white/10 text-xs font-mono text-[#C9CCC8] hover:border-[#00FF88]/50 hover:text-white transition-all bg-white/[0.02]">1–5</button>
            <button onclick="selectTeam(this, 1.1)" class="team-btn px-3 py-3 rounded-xl border border-white/10 text-xs font-mono text-[#C9CCC8] hover:border-[#00FF88]/50 hover:text-white transition-all bg-white/[0.02]">6–20</button>
            <button onclick="selectTeam(this, 1.2)" class="team-btn px-3 py-3 rounded-xl border border-white/10 text-xs font-mono text-[#C9CCC8] hover:border-[#00FF88]/50 hover:text-white transition-all bg-white/[0.02]">21–50</button>
            <button onclick="selectTeam(this, 1.35)" class="team-btn px-3 py-3 rounded-xl border border-white/10 text-xs font-mono text-[#C9CCC8] hover:border-[#00FF88]/50 hover:text-white transition-all bg-white/[0.02]">50+</button>
          </div>
        </div>

        <!-- Result -->
        <div id="result" class="hidden border-t border-white/10 pt-8 relative z-10">
          <p class="text-xs font-mono text-[#8FAF8F] uppercase tracking-wider mb-2">Estimated Annual Operational Drag</p>
          <div class="font-serif text-5xl md:text-6xl font-bold text-[#00FF88] mb-2" id="tax-amount">$0</div>
          <p class="text-sm text-[#C9CCC8] font-sans mb-8 leading-relaxed" id="tax-description"></p>

          <div class="grid grid-cols-3 gap-4 mb-8">
            <div class="bg-white/[0.02] border border-white/10 rounded-2xl p-5 text-center">
              <div class="font-serif text-2xl font-bold text-[#F0EDE6] mb-1" id="roi-amount">$0</div>
              <div class="text-[11px] text-[#8FAF8F] font-mono uppercase tracking-wider">Recoverable Margin</div>
            </div>
            <div class="bg-white/[0.02] border border-white/10 rounded-2xl p-5 text-center">
              <div class="font-serif text-2xl font-bold text-[#F0EDE6] mb-1" id="payback-months">0</div>
              <div class="text-[11px] text-[#8FAF8F] font-mono uppercase tracking-wider">Payback Window</div>
            </div>
            <div class="bg-white/[0.02] border border-white/10 rounded-2xl p-5 text-center">
              <div class="font-serif text-2xl font-bold text-[#00FF88] mb-1" id="roi-multiple">0x</div>
              <div class="text-[11px] text-[#8FAF8F] font-mono uppercase tracking-wider">Year-1 ROI</div>
            </div>
          </div>

          <a href="/start/" class="block w-full text-center bg-[#00FF88] text-[#050508] font-sans font-semibold px-8 py-4 rounded-full hover:bg-[#42FFAA] hover:shadow-[0_0_25px_rgba(0,255,136,0.4)] transition-all text-sm uppercase tracking-wider active:scale-95">
            Book a Free Strategy Call — Eliminate Operational Drag &rarr;
          </a>
          <p class="text-xs text-[#8FAF8F] font-mono text-center mt-3">30-minute scoping call. Calibrated specifically to your Australian operational architecture.</p>
        </div>

      </div>

      <!-- Explainer -->
      <div class="mt-16 text-[#C9CCC8] font-sans leading-relaxed space-y-4">
        <h2 class="font-serif text-2xl md:text-3xl font-semibold text-[#F0EDE6]">What is Operational Drag?</h2>
        <p>Operational drag is the cumulative financial and resource penalty an enterprise incurs when relying on lagging reporting rather than forward-looking predictive models. It includes emergency hiring costs, uncalibrated marketing expenditure running past peak efficiency, overtime from unplanned project spikes, and customer attrition that could have been predicted weeks earlier.</p>
        <p>Research across Australian mid-market operators suggests that organizations operating reactively forfeit between 14% and 22% of unrecovered EBITDA to avoidable friction.</p>
        <p>PresciaIQ's predictive intelligence platforms — <strong class="text-[#F0EDE6]">BuildPredictIQ</strong>, <strong class="text-[#F0EDE6]">AdsIQ</strong>, <strong class="text-[#F0EDE6]">AI Automations &amp; Agents</strong>, and <strong class="text-[#F0EDE6]">HELM OS</strong> — are engineered to eliminate operational drag by arming Australian leaders with holdout-validated foresight before problems compound.</p>
      </div>

    </div>
  </main>

  <script is:inline>
    let industryRate = 0;
    let teamMultiplier = 1.0;

    function selectIndustry(btn, rate) {
      document.querySelectorAll('.industry-btn').forEach(b => {
        b.classList.remove('border-[#00FF88]', 'text-white', 'bg-[#00FF88]/10');
        b.classList.add('border-white/10', 'text-[#C9CCC8]', 'bg-white/[0.02]');
      });
      btn.classList.add('border-[#00FF88]', 'text-white', 'bg-[#00FF88]/10');
      btn.classList.remove('border-white/10', 'text-[#C9CCC8]', 'bg-white/[0.02]');
      industryRate = rate;
      calculateTax();
    }

    function selectTeam(btn, multiplier) {
      document.querySelectorAll('.team-btn').forEach(b => {
        b.classList.remove('border-[#00FF88]', 'text-white', 'bg-[#00FF88]/10');
        b.classList.add('border-white/10', 'text-[#C9CCC8]', 'bg-white/[0.02]');
      });
      btn.classList.add('border-[#00FF88]', 'text-white', 'bg-[#00FF88]/10');
      btn.classList.remove('border-white/10', 'text-[#C9CCC8]', 'bg-white/[0.02]');
      teamMultiplier = multiplier;
      calculateTax();
    }

    function formatCurrency(n) {
      if (n >= 1000000) return '$' + (n / 1000000).toFixed(1) + 'M';
      if (n >= 1000) return '$' + Math.round(n / 1000) + 'K';
      return '$' + Math.round(n);
    }

    function calculateTax() {
      const revenueInput = document.getElementById('revenue-input');
      const revenue = parseFloat(revenueInput.value) || 0;
      if (!revenue || !industryRate || !teamMultiplier) return;

      const tax = Math.round(revenue * industryRate * teamMultiplier);
      const savings = Math.round(tax * 0.65); // PresciaIQ recovers ~65% of operational drag
      const presciaiqCost = 890 * 12; // Base annual calibration
      const payback = Math.max(1, Math.round(presciaiqCost / (savings / 12)));
      const roiMultiple = Math.round(savings / presciaiqCost * 10) / 10;

      document.getElementById('tax-amount').textContent = formatCurrency(tax);
      document.getElementById('roi-amount').textContent = formatCurrency(savings);
      document.getElementById('payback-months').textContent = payback + ' mo';
      document.getElementById('roi-multiple').textContent = roiMultiple + 'x';
      document.getElementById('tax-description').textContent = 
        `Based on your sector parameters and revenue, your organization is likely losing ${formatCurrency(tax)} annually to operational latency. PresciaIQ's intelligence architecture can recover up to 65% of this — recapturing ${formatCurrency(savings)} in annualized EBITDA.`;
      document.getElementById('result').classList.remove('hidden');
    }
  </script>
</Layout>
