---
import Layout from '../../layouts/Layout.astro';
import { competitors } from '../../data/competitors';

export function getStaticPaths() {
  return competitors.map(competitor => ({
    params: { slug: competitor.slug },
    props: { competitor },
  }));
}

const { competitor } = Astro.props;

const title = `PresciaIQ vs ${competitor.name} | Predictive AI vs ${competitor.category}`;
const description = `Compare ${competitor.name} vs PresciaIQ. Discover why Australian businesses are moving from traditional ${competitor.category} to predictive AI and decision automation.`;
const canonicalURL = `https://www.presciaiq.com.au/compare/${competitor.slug}/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.presciaiq.com.au" },
    { "@type": "ListItem", "position": 2, "name": "Compare", "item": "https://www.presciaiq.com.au/compare" },
    { "@type": "ListItem", "position": 3, "name": `PresciaIQ vs ${competitor.name}`, "item": canonicalURL }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": competitor.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout title={title} description={description} canonicalURL={canonicalURL}
  noindex={true}
>
  <div class="pt-32 pb-24 min-h-screen">
    <div class="max-w-4xl mx-auto px-6">
      
      <div class="glass-card p-8 md:p-12 border border-[#00ff88]/20 mb-12">
        <div class="mb-8">
          <span class="text-[#00ff88] font-semibold uppercase tracking-widest text-xs bg-[#00ff88]/10 px-3 py-1 rounded-full">Comparison</span>
        </div>

        <h1 class="font-display text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">PresciaIQ vs {competitor.name}</h1>
        <p class="text-xl text-gray-400 mb-10 font-medium">{competitor.tagline}</p>
        
        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <div class="bg-black/40 border border-white/10 p-6 rounded-lg">
            <h2 class="text-xl font-bold text-white mb-4">The {competitor.name} Approach</h2>
            <p class="text-gray-400 leading-relaxed">{competitor.theirApproach}</p>
          </div>
          <div class="bg-black/40 border border-[#00ff88]/30 p-6 rounded-lg relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-[#00ff88] to-transparent"></div>
            <h2 class="text-xl font-bold text-white mb-4">The PresciaIQ Advantage</h2>
            <p class="text-gray-300 leading-relaxed">{competitor.presciaiqAdvantage}</p>
          </div>
        </div>

        <h2 class="text-2xl font-bold text-white mb-6">Key Differences</h2>
        <div class="overflow-x-auto mb-12">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-white/10">
                <th class="py-4 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider">Feature</th>
                <th class="py-4 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider">{competitor.name}</th>
                <th class="py-4 px-4 text-sm font-semibold text-[#00ff88] uppercase tracking-wider">PresciaIQ</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {competitor.keyDifferences.map(diff => (
                <tr class="hover:bg-white/5 transition-colors">
                  <td class="py-4 px-4 text-sm font-medium text-white">{diff.label}</td>
                  <td class="py-4 px-4 text-sm text-gray-400">{diff.them}</td>
                  <td class="py-4 px-4 text-sm text-gray-300 font-medium">{diff.us}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {/* CTA Section */}
        <div class="bg-gradient-to-r from-[#00ff88]/20 to-transparent p-8 rounded-xl border border-[#00ff88]/30 mb-16">
          <h3 class="text-2xl font-bold text-white mb-4">Ready to move beyond dashboards?</h3>
          <p class="text-gray-300 mb-6">Stop paying for tools that just record history. Let's discuss how predictive AI can transform your operations.</p>
          <a href="/contact" class="inline-block bg-[#00ff88] text-black font-bold px-8 py-4 rounded-lg hover:bg-[#00ff88]/90 transition-colors">
            Book a Strategy Call
          </a>
        </div>

        {/* FAQ Section */}
        <div class="border-t border-white/10 pt-12">
          <h2 class="text-3xl font-bold text-white mb-8">Frequently Asked Questions</h2>
          <div class="space-y-8">
            {competitor.faqs.map(faq => (
              <div>
                <h3 class="text-xl font-bold text-white mb-3">{faq.q}</h3>
                <p class="text-gray-400 leading-relaxed">{faq.a}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

        <div class="mt-12 pt-8 border-t border-white/10">
          <p class="text-[11px] uppercase tracking-[0.2em] text-[#00ff88] font-sans font-semibold mb-4">Explore More</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <a href="/services/aeo-seo-predictive-search-architecture" class="group block p-6 rounded-xl border border-white/10 hover:border-[#00ff88]/50 hover:bg-white/5 transition-all">
              <h4 class="text-lg font-bold text-white group-hover:text-[#00ff88] transition-colors mb-2">AEO &amp; Predictive Search</h4>
              <p class="text-sm text-gray-400">See how PresciaIQ builds search architecture that compounds over time. &rarr;</p>
            </a>
            <a href="/services/ai-software-development" class="group block p-6 rounded-xl border border-white/10 hover:border-[#00ff88]/50 hover:bg-white/5 transition-all">
              <h4 class="text-lg font-bold text-white group-hover:text-[#00ff88] transition-colors mb-2">AI Software Development</h4>
              <p class="text-sm text-gray-400">Custom predictive AI platforms built for Australian businesses. &rarr;</p>
            </a>
            <a href="/insights/what-is-aeo-answer-engine-optimisation-australia" class="group block p-6 rounded-xl border border-white/10 hover:border-[#00ff88]/50 hover:bg-white/5 transition-all">
              <h4 class="text-lg font-bold text-white group-hover:text-[#00ff88] transition-colors mb-2">What is AEO?</h4>
              <p class="text-sm text-gray-400">The definitive guide to Answer Engine Optimisation in Australia. &rarr;</p>
            </a>
            <a href="/insights/the-reaction-tax" class="group block p-6 rounded-xl border border-white/10 hover:border-[#00ff88]/50 hover:bg-white/5 transition-all">
              <h4 class="text-lg font-bold text-white group-hover:text-[#00ff88] transition-colors mb-2">The Reaction Tax</h4>
              <p class="text-sm text-gray-400">Why most Australian businesses are paying to be surprised. &rarr;</p>
            </a>
          </div>
        </div>
</Layout>
