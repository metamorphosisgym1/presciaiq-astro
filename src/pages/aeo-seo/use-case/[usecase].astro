---
import Layout from '../../../layouts/Layout.astro';
import { aeoUseCases } from '../../../data/aeo-use-cases';

export function getStaticPaths() {
  return aeoUseCases.map(useCase => ({
    params: { usecase: useCase.slug },
    props: { useCase },
  }));
}

const { useCase } = Astro.props;
const title = `${useCase.title} | PresciaIQ Predictive Search Architecture`;
const description = `${useCase.description} ${useCase.outcome} From $4,999.`;
const canonicalURL = `https://www.presciaiq.com.au/aeo-seo/use-case/${useCase.slug}`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.presciaiq.com.au" },
    { "@type": "ListItem", "position": 2, "name": "AEO/SEO", "item": "https://www.presciaiq.com.au/services/aeo-seo-predictive-search-architecture" },
    { "@type": "ListItem", "position": 3, "name": useCase.shortTitle, "item": canonicalURL }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": useCase.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};
---
<Layout title={title} description={description}>
  <div class="pt-32 pb-24 min-h-screen">
    <div class="max-w-4xl mx-auto px-6">

      <div class="glass-card p-8 md:p-12 border border-[#00ff88]/20 mb-12">
        <div class="mb-8 flex flex-wrap gap-3">
          <span class="text-[#00ff88] font-semibold uppercase tracking-widest text-xs bg-[#00ff88]/10 px-3 py-1 rounded-full">Use Case</span>
          <span class="text-white/70 font-semibold uppercase tracking-widest text-xs bg-white/5 px-3 py-1 rounded-full">{useCase.category}</span>
        </div>
        <h1 class="font-display text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">
          {useCase.title}
        </h1>
        <p class="text-xl text-gray-400 mb-10 font-medium leading-relaxed">
          {useCase.description}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
          <div class="bg-black/40 border border-white/10 rounded-xl p-6">
            <p class="text-[11px] uppercase tracking-[0.2em] text-[#00ff88] font-sans font-semibold mb-3">Pages Generated</p>
            <p class="text-white font-bold text-lg">{useCase.pagesGenerated}</p>
          </div>
          <div class="bg-black/40 border border-[#00ff88]/20 rounded-xl p-6">
            <p class="text-[11px] uppercase tracking-[0.2em] text-[#00ff88] font-sans font-semibold mb-3">Proven Result</p>
            <p class="text-gray-300 text-sm leading-relaxed"><strong class="text-white">{useCase.exampleClient}:</strong> {useCase.exampleResult}</p>
          </div>
        </div>

        <div class="bg-black/40 border-l-4 border-[#00ff88] p-6 mb-12 rounded-r-lg">
          <h2 class="text-xl font-bold text-white mb-3">How It Works</h2>
          <p class="text-gray-300 leading-relaxed font-medium">{useCase.howItWorks}</p>
        </div>

        <div class="prose prose-invert prose-lg max-w-none font-sans text-gray-400 leading-relaxed mb-16">
          <h3 class="text-2xl font-bold text-white mt-4 mb-6">The Outcome</h3>
          <p>{useCase.outcome}</p>

          <h3 class="text-2xl font-bold text-white mt-12 mb-6">Why This Approach Works</h3>
          <p>Google rewards structural depth and topical authority — the breadth and depth of coverage across a specific subject. {useCase.title} builds this authority programmatically, deploying the structural depth that manual content creation can never achieve.</p>

          <p>Each page in the cluster is unique, highly optimised, and schema-rich — targeting a specific search query that your competitors haven't identified. The result is a website that captures the full search demand landscape for your category, leaving nothing on the table.</p>

          <p class="text-white font-medium border-l-2 border-white/20 pl-4 py-2 mt-8">
            Unlike traditional SEO retainers, this is an infrastructural build. You pay once for the architecture, and it compounds in value over time — dominating both traditional search and AI Answer Engines.
          </p>
        </div>

        <div class="bg-gradient-to-r from-[#00ff88]/20 to-transparent p-8 rounded-xl border border-[#00ff88]/30 mb-16">
          <h3 class="text-2xl font-bold text-white mb-4">Ready to deploy {useCase.shortTitle}?</h3>
          <p class="text-gray-300 mb-6">Let's build the search architecture that captures every query in your market — starting from $4,999.</p>
          <div class="flex flex-wrap gap-4">
            <a href="/contact" class="inline-block bg-[#00ff88] text-black font-bold px-8 py-4 rounded-lg hover:bg-[#00ff88]/90 transition-colors">
              Book a Strategy Call
            </a>
            <a href="/services/aeo-seo-predictive-search-architecture" class="inline-block bg-transparent text-white border border-white/20 font-bold px-8 py-4 rounded-lg hover:bg-white/5 transition-colors">
              Learn more about Predictive Search Architecture
            </a>
          </div>
        </div>

        <div class="border-t border-white/10 pt-12">
          <h2 class="text-3xl font-bold text-white mb-8">Frequently Asked Questions</h2>
          <div class="space-y-8">
            {useCase.faqs.map(faq => (
              <div>
                <h3 class="text-xl font-bold text-white mb-3">{faq.q}</h3>
                <p class="text-gray-400 leading-relaxed">{faq.a}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
