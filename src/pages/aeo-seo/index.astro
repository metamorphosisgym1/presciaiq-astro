---
import Layout from '../../layouts/Layout.astro';
import { locations } from '../../data/locations';
import { industries } from '../../data/industries';
import { aeoPersonas } from '../../data/aeo-personas';
import { aeoProblems } from '../../data/aeo-problems';
import { aeoCompetitors } from '../../data/aeo-competitors';
import { aeoUseCases } from '../../data/aeo-use-cases';

const title = "AEO/SEO — Predictive Search Architecture | PresciaIQ";
const description = "PresciaIQ builds programmatic SEO and AEO architectures that deploy hundreds to thousands of targeted, schema-rich pages in a single build. Own every search result before your competitor knows the query exists. From $4,999.";
const canonicalURL = "https://www.presciaiq.com.au/aeo-seo";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.presciaiq.com.au" },
    { "@type": "ListItem", "position": 2, "name": "AEO/SEO", "item": canonicalURL }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Predictive Search Architecture?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Predictive Search Architecture is a programmatic SEO and AEO build that deploys hundreds to thousands of targeted, schema-rich pages in a single deployment — generating compounding organic authority with zero ongoing ad spend. Unlike traditional SEO retainers, it is a one-off infrastructural build that compounds in value over time."
      }
    },
    {
      "@type": "Question",
      "name": "How much does Predictive Search Architecture cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Predictive Search Architecture starts from $4,999 as a one-off build. Unlike monthly SEO retainers that cost $1,500–$5,000/month with slow results, this is a single investment that generates compounding organic authority over time."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between SEO and AEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SEO (Search Engine Optimisation) optimises your website for traditional search engines like Google. AEO (Answer Engine Optimisation) optimises your website for AI Answer Engines like ChatGPT, Perplexity, and Google AI Overviews. Predictive Search Architecture covers both simultaneously — ensuring your business dominates both traditional search and AI-mediated discovery."
      }
    }
  ]
};
---
<Layout title={title} description={description}>
  <div class="pt-32 pb-24 min-h-screen">
    <div class="max-w-6xl mx-auto px-6">

      <!-- Hero -->
      <div class="text-center mb-20">
        <div class="mb-6 flex flex-wrap gap-3 justify-center">
          <span class="text-[#00ff88] font-semibold uppercase tracking-widest text-xs bg-[#00ff88]/10 px-3 py-1 rounded-full">AEO/SEO</span>
          <span class="text-white/50 font-semibold uppercase tracking-widest text-xs bg-white/5 px-3 py-1 rounded-full">From $4,999</span>
        </div>
        <h1 class="font-display text-5xl md:text-6xl font-bold text-white mb-6 leading-tight">
          Predictive Search Architecture
        </h1>
        <p class="text-xl text-gray-400 mb-10 font-medium leading-relaxed max-w-3xl mx-auto">
          Own every search result before your competitor knows the query exists. We build programmatic SEO and AEO architectures that deploy hundreds to thousands of targeted, schema-rich pages in a single build.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/contact" class="inline-block bg-[#00ff88] text-black font-bold px-8 py-4 rounded-lg hover:bg-[#00ff88]/90 transition-colors">
            Book a Strategy Call
          </a>
          <a href="/services/aeo-seo-predictive-search-architecture" class="inline-block bg-transparent text-white border border-white/20 font-bold px-8 py-4 rounded-lg hover:bg-white/5 transition-colors">
            Service Overview
          </a>
        </div>
      </div>

      <!-- Results proof -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
        <div class="glass-card p-6 border border-[#00ff88]/20 text-center">
          <p class="text-4xl font-bold text-[#00ff88] mb-2">8x</p>
          <p class="text-white font-semibold mb-1">BuildHire</p>
          <p class="text-gray-400 text-sm">216 → 7,398 pages</p>
        </div>
        <div class="glass-card p-6 border border-[#00ff88]/20 text-center">
          <p class="text-4xl font-bold text-[#00ff88] mb-2">15x</p>
          <p class="text-white font-semibold mb-1">LoopBC</p>
          <p class="text-gray-400 text-sm">380 → 5,763 pages</p>
        </div>
        <div class="glass-card p-6 border border-[#00ff88]/20 text-center">
          <p class="text-4xl font-bold text-[#00ff88] mb-2">6x</p>
          <p class="text-white font-semibold mb-1">PresciaIQ</p>
          <p class="text-gray-400 text-sm">954 → 6,129 pages</p>
        </div>
      </div>

      <!-- By Location -->
      <div class="mb-20">
        <h2 class="text-3xl font-bold text-white mb-4">By Location</h2>
        <p class="text-gray-400 mb-8">Predictive Search Architecture for businesses in every major market.</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {locations.map(location => (
            <a href={`/aeo-seo/location/${location.slug}`} class="group block p-4 rounded-xl border border-white/10 hover:border-[#00ff88]/50 hover:bg-white/5 transition-all">
              <p class="text-white font-semibold group-hover:text-[#00ff88] transition-colors text-sm">{location.name}</p>
            </a>
          ))}
        </div>
      </div>

      <!-- By Industry -->
      <div class="mb-20">
        <h2 class="text-3xl font-bold text-white mb-4">By Industry</h2>
        <p class="text-gray-400 mb-8">Industry-specific search architecture for every sector we serve.</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {industries.map(industry => (
            <a href={`/aeo-seo/industry/${industry.slug}`} class="group block p-4 rounded-xl border border-white/10 hover:border-[#00ff88]/50 hover:bg-white/5 transition-all">
              <p class="text-white font-semibold group-hover:text-[#00ff88] transition-colors text-sm">{industry.name}</p>
            </a>
          ))}
        </div>
      </div>

      <!-- By Persona -->
      <div class="mb-20">
        <h2 class="text-3xl font-bold text-white mb-4">By Role</h2>
        <p class="text-gray-400 mb-8">Built for every decision-maker in your organisation.</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {aeoPersonas.map(persona => (
            <a href={`/aeo-seo/for/${persona.slug}`} class="group block p-4 rounded-xl border border-white/10 hover:border-[#00ff88]/50 hover:bg-white/5 transition-all">
              <p class="text-white font-semibold group-hover:text-[#00ff88] transition-colors text-sm">{persona.name}</p>
            </a>
          ))}
        </div>
      </div>

      <!-- Problems we solve -->
      <div class="mb-20">
        <h2 class="text-3xl font-bold text-white mb-4">Problems We Solve</h2>
        <p class="text-gray-400 mb-8">Every search problem has a structural solution.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {aeoProblems.map(problem => (
            <a href={`/aeo-seo/problem/${problem.slug}`} class="group block p-5 rounded-xl border border-white/10 hover:border-[#00ff88]/50 hover:bg-white/5 transition-all">
              <p class="text-white font-semibold group-hover:text-[#00ff88] transition-colors text-sm mb-1">{problem.problemTitle}</p>
              <p class="text-gray-500 text-xs">{problem.problemShort}</p>
            </a>
          ))}
        </div>
      </div>

      <!-- Use Cases -->
      <div class="mb-20">
        <h2 class="text-3xl font-bold text-white mb-4">Use Cases</h2>
        <p class="text-gray-400 mb-8">Every cluster type, explained.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {aeoUseCases.map(useCase => (
            <a href={`/aeo-seo/use-case/${useCase.slug}`} class="group block p-5 rounded-xl border border-white/10 hover:border-[#00ff88]/50 hover:bg-white/5 transition-all">
              <p class="text-[11px] uppercase tracking-[0.2em] text-[#00ff88] font-sans font-semibold mb-2">{useCase.category}</p>
              <p class="text-white font-semibold group-hover:text-[#00ff88] transition-colors text-sm mb-1">{useCase.title}</p>
              <p class="text-gray-500 text-xs">{useCase.pagesGenerated}</p>
            </a>
          ))}
        </div>
      </div>

      <!-- Comparisons -->
      <div class="mb-20">
        <h2 class="text-3xl font-bold text-white mb-4">How We Compare</h2>
        <p class="text-gray-400 mb-8">See how Predictive Search Architecture compares to every alternative.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {aeoCompetitors.map(competitor => (
            <a href={`/aeo-seo/compare/${competitor.slug}`} class="group block p-5 rounded-xl border border-white/10 hover:border-[#00ff88]/50 hover:bg-white/5 transition-all">
              <p class="text-[11px] uppercase tracking-[0.2em] text-gray-500 font-sans font-semibold mb-2">{competitor.category}</p>
              <p class="text-white font-semibold group-hover:text-[#00ff88] transition-colors text-sm">PresciaIQ vs {competitor.name}</p>
            </a>
          ))}
        </div>
      </div>

      <!-- FAQ -->
      <div class="border-t border-white/10 pt-16">
        <h2 class="text-3xl font-bold text-white mb-8">Frequently Asked Questions</h2>
        <div class="space-y-8">
          <div>
            <h3 class="text-xl font-bold text-white mb-3">What is Predictive Search Architecture?</h3>
            <p class="text-gray-400 leading-relaxed">Predictive Search Architecture is a programmatic SEO and AEO build that deploys hundreds to thousands of targeted, schema-rich pages in a single deployment — generating compounding organic authority with zero ongoing ad spend. Unlike traditional SEO retainers, it is a one-off infrastructural build that compounds in value over time.</p>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-3">How much does Predictive Search Architecture cost?</h3>
            <p class="text-gray-400 leading-relaxed">Predictive Search Architecture starts from $4,999 as a one-off build. Unlike monthly SEO retainers that cost $1,500–$5,000/month with slow results, this is a single investment that generates compounding organic authority over time.</p>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-3">What is the difference between SEO and AEO?</h3>
            <p class="text-gray-400 leading-relaxed">SEO (Search Engine Optimisation) optimises your website for traditional search engines like Google. AEO (Answer Engine Optimisation) optimises your website for AI Answer Engines like ChatGPT, Perplexity, and Google AI Overviews. Predictive Search Architecture covers both simultaneously — ensuring your business dominates both traditional search and AI-mediated discovery.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
