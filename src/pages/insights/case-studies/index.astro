---
import Layout from '../../../layouts/Layout.astro';

const title = "Case Studies | PresciaIQ AI Results";
const description = "Real results from PresciaIQ clients — how BuildHire, LoopBC, and LongevityAus used predictive AI to grow revenue and eliminate operational guesswork.";
const canonicalURL = new URL("/insights/case-studies/", Astro.site).href;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": canonicalURL,
      "publisher": { "@type": "Organization", "name": "PresciaIQ", "url": "https://www.presciaiq.com.au" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.presciaiq.com.au/" },
        { "@type": "ListItem", "position": 2, "name": "Insights", "item": "https://www.presciaiq.com.au/insights/" },
        { "@type": "ListItem", "position": 3, "name": "Case Studies", "item": canonicalURL }
      ]
    }
  ]
};

const caseStudies = [
  {
    slug: "buildhire",
    client: "BuildHire",
    tag: "pSEO Architecture",
    industry: "Construction & Equipment Hire",
    headline: "From $90 CPC to Zero: 84,000-Page Organic Search Architecture",
    description: "How PresciaIQ replaced BuildHire's paid ad dependency with a permanent programmatic SEO infrastructure covering 83 NSW locations and 12 construction industry sub-sectors.",
    metrics: [
      { stat: "84,000", label: "Organic pages" },
      { stat: "$0", label: "Cost per organic visit" },
      { stat: "83", label: "NSW locations" },
    ],
    href: "/insights/case-studies/buildhire/",
  },
  {
    slug: "loopbc",
    client: "LoopBC",
    tag: "AdsIQ + pSEO",
    industry: "Digital Marketing Agency",
    headline: "Predicting Campaign ROAS Before a Dollar Is Spent",
    description: "How PresciaIQ integrated AdsIQ predictive campaign scoring into LoopBC's pitch workflow and built a pSEO architecture spanning 21 industry verticals for organic lead generation.",
    metrics: [
      { stat: "84%", label: "ROAS accuracy" },
      { stat: "31%", label: "ROAS improvement" },
      { stat: "21", label: "Industry verticals" },
    ],
    href: "/insights/case-studies/loopbc/",
  },
  {
    slug: "longevityaus",
    client: "LongevityAus",
    tag: "AI App Development",
    industry: "Health Technology",
    headline: "Australia's First AI-Powered Predictive Wellness Platform",
    description: "How PresciaIQ designed and built a HIPAA-compliant predictive health platform — including the prediction engine, consumer app, and pSEO user acquisition architecture — in under three weeks.",
    metrics: [
      { stat: "14", label: "Biomarkers tracked" },
      { stat: "2–3wk", label: "Build timeline" },
      { stat: "3–6mo", label: "Risk horizon" },
    ],
    href: "/insights/case-studies/longevityaus/",
  },
];
---

<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="min-h-screen bg-background text-foreground">
    <div class="border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <nav class="flex items-center gap-2 text-sm text-muted-foreground font-sans flex-wrap">
          <a href="/" class="hover:text-primary transition-colors">Home</a>
          <span>/</span>
          <a href="/insights/" class="hover:text-primary transition-colors">Insights</a>
          <span>/</span>
          <span class="text-foreground">Case Studies</span>
        </nav>
      </div>
    </div>

    <section class="py-16 md:py-24 border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-xs uppercase tracking-[0.25em] text-primary font-sans font-semibold mb-4">Case Studies</p>
        <h1 class="font-display text-4xl md:text-5xl font-bold text-foreground mb-4 max-w-3xl">
          Real Results from Real Australian Businesses
        </h1>
        <p class="text-lg text-muted-foreground font-sans max-w-2xl leading-relaxed">
          Every engagement PresciaIQ takes on is documented here — the problem, the solution, the technical decisions, and the measurable outcomes.
        </p>
      </div>
    </section>

    <section class="py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid gap-8">
          {caseStudies.map(cs => (
            <a href={cs.href} class="group block rounded-2xl border border-white/8 p-8 hover:border-primary/30 transition-all duration-300" style="background: rgba(255,255,255,0.02);">
              <div class="flex flex-wrap items-center gap-3 mb-4">
                <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold text-primary border border-primary/20 bg-primary/5">{cs.tag}</span>
                <span class="text-xs text-muted-foreground font-sans">{cs.industry}</span>
              </div>
              <h2 class="font-display text-2xl font-bold text-foreground mb-3 group-hover:text-primary transition-colors">{cs.headline}</h2>
              <p class="text-muted-foreground font-sans leading-relaxed mb-6 max-w-2xl">{cs.description}</p>
              <div class="flex flex-wrap gap-6 mb-4">
                {cs.metrics.map(m => (
                  <div>
                    <p class="font-mono text-xl font-bold text-primary">{m.stat}</p>
                    <p class="text-xs text-muted-foreground font-sans">{m.label}</p>
                  </div>
                ))}
              </div>
              <p class="text-sm text-primary font-sans font-semibold group-hover:underline">Read Case Study →</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 border-t border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="font-display text-2xl font-bold text-foreground mb-3">Ready to Become a Case Study?</h2>
        <p class="text-muted-foreground font-sans mb-6 max-w-lg mx-auto">Book a free discovery call and we'll show you exactly what a PresciaIQ engagement would look like for your business.</p>
        <a href="/start/" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-primary text-primary-foreground font-semibold text-sm font-sans hover:shadow-[0_0_20px_rgba(0,255,136,0.3)] transition-all duration-500">
          Book a Free Discovery Call →
        </a>
      </div>
    </section>
  </main>
</Layout>
