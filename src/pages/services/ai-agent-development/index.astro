---
import Layout from '../../../layouts/Layout.astro';

// Hand written 24 Nov 2026 (catalogue line 04, AI Development and Agents). No prices: ASK FIRST.
// KW-06: the "ai agent development australia" SERP shares no results with "ai software development australia", so this is its own page.
const title = "AI Agent Development Australia, Chatbots and Receptionists | PresciaIQ";
const description = "Custom AI agents for Australian businesses: receptionists that answer calls, chat agents, lead qualification, booking and support agents, built in Sydney.";
const canonicalURL = "https://www.presciaiq.com.au/services/ai-agent-development/";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AI agent development",
    "serviceType": "Custom AI agent development",
    "provider": { "@type": "Organization", "name": "PresciaIQ", "url": "https://www.presciaiq.com.au/" },
    "areaServed": { "@type": "Country", "name": "Australia" },
    "url": canonicalURL,
    "description": description
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.presciaiq.com.au/" },
      { "@type": "ListItem", "position": 2, "name": "Development", "item": "https://www.presciaiq.com.au/development/" },
      { "@type": "ListItem", "position": 3, "name": "AI agent development", "item": canonicalURL }
    ]
  }
];

const agents = [
  { name: "AI receptionists", text: "Answer calls, take the details and book the job, day or night." },
  { name: "Lead qualification agents", text: "Ask the questions your sales team would ask, then pass on the leads worth a call." },
  { name: "Follow up and booking agents", text: "Chase quotes and book appointments by email, WhatsApp or SMS." },
  { name: "Website chat agents", text: "Answer buyer questions on your site from your own content." },
  { name: "Support and helpdesk agents", text: "Handle common customer questions and hand the hard ones to a person." },
  { name: "Data entry and CRM agents", text: "Read emails and documents, then update your CRM so nobody types it twice." },
];
---

<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="relative bg-background text-foreground overflow-x-hidden min-h-screen">
    <div class="pointer-events-none fixed inset-0 z-0 bg-[radial-gradient(ellipse_at_top_right,rgba(0,255,136,0.12),transparent_60%)]" aria-hidden="true"></div>
    <div class="pointer-events-none fixed inset-0 z-0 grid-overlay opacity-60" aria-hidden="true"></div>

    <!-- HERO -->
    <section class="relative z-10 border-b border-white/5">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-12 text-left md:text-center">
        <nav class="flex items-center gap-2 text-xs text-muted-foreground font-mono mb-8 md:justify-center flex-wrap" aria-label="Breadcrumb">
          <a href="/" class="hover:text-primary transition-colors">Home</a>
          <span class="text-white/20">/</span>
          <a href="/development/" class="hover:text-primary transition-colors">Development</a>
          <span class="text-white/20">/</span>
          <span class="text-foreground">AI agent development</span>
        </nav>

        <h1 class="text-4xl md:text-6xl font-serif font-semibold text-[#F0EDE6] tracking-tight mb-6 leading-[1.1]">
          AI agent development <span class="text-[#00FF88] italic">in Australia</span>
        </h1>

        <p class="text-lg text-[#C9CCC8] font-sans leading-relaxed max-w-3xl mx-auto mb-8">
          We build AI agents that do real work for Australian businesses. They answer calls, qualify leads, book jobs and handle support questions. Each agent is built around your own process and data, then connected to the tools your team already uses.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/start/" id="hero-cta-agents-start" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-[#00FF88] text-[#050508] font-semibold text-sm font-sans hover:bg-[#42FFAA] hover:shadow-[0_0_28px_rgba(0,255,136,0.45)] transition-all duration-300">
            Start your project
          </a>
          <a href="tel:+61400457006" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl border border-white/10 bg-white/[0.04] text-[#F0EDE6] font-semibold text-sm font-sans hover:border-[#00FF88]/40 transition-all duration-300">
            Call +61 400 457 006
          </a>
        </div>
      </div>
    </section>

    <!-- AGENTS + CLIP -->
    <section class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_260px] gap-10 items-start">
        <div>
          <h2 class="text-3xl md:text-4xl font-serif font-semibold text-[#F0EDE6] tracking-tight mb-4">AI agents we build</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {agents.map((a) => (
              <div class="rounded-2xl border border-white/10 bg-[#111411]/80 p-6">
                <h3 class="text-lg font-serif font-semibold text-[#F0EDE6] mb-2">{a.name}</h3>
                <p class="text-sm text-[#C9CCC8] font-sans leading-relaxed">{a.text}</p>
              </div>
            ))}
          </div>
          <p class="text-sm text-[#C9CCC8] font-sans leading-relaxed mt-6">
            We also build recruitment and onboarding agents, ecommerce agents, agents for real estate and multi agent systems where several agents hand work to each other.
          </p>
        </div>
        <figure class="mx-auto w-full max-w-[260px]">
          <div class="overflow-hidden rounded-2xl border border-white/10 bg-[#111411] shadow-[0_0_40px_-10px_rgba(0,255,136,0.25)]">
            <video class="block w-full h-auto" width="540" height="960" poster="/video/ai-agents-poster.jpg" preload="none" controls muted playsinline aria-label="AI development and agents slide from the PresciaIQ service catalogue">
              <source src="/video/ai-agents.mp4" type="video/mp4" />
            </video>
          </div>
          <figcaption class="mt-3 text-xs text-[#8FAF8F] font-mono text-center">AI development and agents, from our service catalogue</figcaption>
        </figure>
      </div>
    </section>

    <!-- UNDER THE HOOD -->
    <section class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 border-t border-white/5">
      <h2 class="text-3xl md:text-4xl font-serif font-semibold text-[#F0EDE6] tracking-tight mb-6">What the agents are built on</h2>
      <div class="space-y-4 text-[#C9CCC8] font-sans leading-relaxed">
        <p>We build on OpenAI, Claude and Gemini models, picked per job. Agents that need to know your business read from a private knowledge base (a RAG system with vector search), so answers come from your documents, products and policies.</p>
        <p>The agent then connects to your phone line, website, email, WhatsApp, SMS or CRM.</p>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 border-t border-white/5">
      <h2 class="text-3xl md:text-4xl font-serif font-semibold text-[#F0EDE6] tracking-tight mb-8">How an agent project starts</h2>
      <ol class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <li class="rounded-2xl border border-white/10 bg-[#111411]/80 p-5">
          <div class="text-xs font-mono text-[#00FF88] mb-2">STEP 1</div>
          <h3 class="font-serif font-semibold text-[#F0EDE6] mb-2">Show us the task</h3>
          <p class="text-sm text-[#C9CCC8] leading-relaxed">Which calls, emails or forms eat your team's day, and what a good outcome looks like.</p>
        </li>
        <li class="rounded-2xl border border-white/10 bg-[#111411]/80 p-5">
          <div class="text-xs font-mono text-[#00FF88] mb-2">STEP 2</div>
          <h3 class="font-serif font-semibold text-[#F0EDE6] mb-2">We scope one agent first</h3>
          <p class="text-sm text-[#C9CCC8] leading-relaxed">We recommend the smallest build that takes that task off your plate, and scope it clearly before work starts.</p>
        </li>
        <li class="rounded-2xl border border-white/10 bg-[#111411]/80 p-5">
          <div class="text-xs font-mono text-[#00FF88] mb-2">STEP 3</div>
          <h3 class="font-serif font-semibold text-[#F0EDE6] mb-2">Build, test, go live</h3>
          <p class="text-sm text-[#C9CCC8] leading-relaxed">We build it on your data, test it, then connect it to your live tools.</p>
        </li>
      </ol>
    </section>

    <!-- NOT THE RIGHT FIT -->
    <section class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 border-t border-white/5">
      <h2 class="text-3xl md:text-4xl font-serif font-semibold text-[#F0EDE6] tracking-tight mb-6">When an AI agent is not the right job for you</h2>
      <div class="space-y-4 text-[#C9CCC8] font-sans leading-relaxed">
        <p>If the task follows the same fixed steps every time, a plain automation is cheaper and more reliable than an agent. See our <a href="/products/ai-automations/" class="text-[#00FF88] hover:underline underline-offset-4">business automation</a> work for that.</p>
        <p>If the process is not written down anywhere and changes person to person, an agent will copy the mess. Agree the process first, then automate it.</p>
      </div>
    </section>

    <!-- QUESTIONS -->
    <section class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 border-t border-white/5">
      <h2 class="text-3xl md:text-4xl font-serif font-semibold text-[#F0EDE6] tracking-tight mb-8">Questions buyers ask us</h2>
      <div class="space-y-8">
        <div>
          <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-2">Does it cost money to build an AI agent?</h3>
          <p class="text-[#C9CCC8] font-sans leading-relaxed">Yes. There is a build cost, and then a monthly running cost. We quote after a short scoping call. The price depends on how many tasks the agent handles, how many tools it connects to and how many conversations it handles. For typical figures, read our guide to <a href="/insights/ai-customer-support-agent-cost-australia/" class="text-[#00FF88] hover:underline underline-offset-4">AI customer support agent costs in Australia</a>.</p>
        </div>
        <div>
          <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-2">What is the difference between an AI agent and a chatbot?</h3>
          <p class="text-[#C9CCC8] font-sans leading-relaxed">A chatbot answers questions in a chat window. An AI agent takes action: it can book the appointment, update the CRM, send the follow up or hand the lead to sales.</p>
        </div>
        <div>
          <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-2">Can an AI receptionist answer my business phone?</h3>
          <p class="text-[#C9CCC8] font-sans leading-relaxed">Yes. An AI receptionist picks up calls, answers common questions, takes the caller's details and books the job or passes it to your team. Our guide on <a href="/insights/voice-ai-agents-for-trades/" class="text-[#00FF88] hover:underline underline-offset-4">voice AI agents for trades</a> shows how this works on inbound calls.</p>
        </div>
        <div>
          <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-2">Will the agent make things up?</h3>
          <p class="text-[#C9CCC8] font-sans leading-relaxed">It can. We limit that by having it answer from your own knowledge base and testing it before it goes live. Complex questions go to a person.</p>
        </div>
        <div>
          <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-2">Which AI models do you use?</h3>
          <p class="text-[#C9CCC8] font-sans leading-relaxed">We build on OpenAI, Claude and Gemini models and pick the one that suits each task. We also do prompt engineering and model fine tuning when a job needs it.</p>
        </div>
        <div>
          <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-2">Do you only build agents?</h3>
          <p class="text-[#C9CCC8] font-sans leading-relaxed">No. We also build custom AI apps, AI SaaS products, internal knowledge assistants, AI copilots, document processing and search systems. See <a href="/services/ai-software-development/" class="text-[#00FF88] hover:underline underline-offset-4">AI software development</a> for the wider build work.</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative z-10 px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-[#111411]/90 p-8 md:p-14 text-center max-w-4xl mx-auto my-16">
        <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 rounded-full bg-[radial-gradient(circle,rgba(0,255,136,0.15),transparent_70%)] blur-2xl" aria-hidden="true"></div>
        <div class="relative">
          <h2 class="font-serif text-3xl md:text-5xl font-semibold text-[#F0EDE6] tracking-tight mb-4">Which task would you hand to an agent first?</h2>
          <p class="text-[#C9CCC8] text-base md:text-lg max-w-xl mx-auto mb-8 font-sans leading-relaxed">Tell us the job that eats your team's day. We will come back with a clear scope for one agent.</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/start/" id="cta-bottom-agents-start" class="inline-flex items-center justify-center gap-2 bg-[#00FF88] text-[#050508] font-semibold text-base px-8 py-3.5 rounded-full hover:bg-[#00FF88]/90 transition-all duration-300">Start your project</a>
            <a href="tel:+61400457006" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full border border-white/10 bg-white/[0.04] text-[#F0EDE6] font-semibold text-sm font-sans hover:border-[#00FF88]/40 transition-all duration-300">Call +61 400 457 006</a>
          </div>
        </div>
      </div>
    </section>

    <!-- RELATED -->
    <section class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 mb-12 border-t border-white/5">
      <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-[#8FAF8F] mb-4">Related</h2>
      <div class="flex flex-wrap items-center gap-3">
        <a href="/development/" class="text-xs font-mono text-[#00FF88] hover:underline bg-white/[0.03] px-3 py-1.5 rounded-lg border border-white/10">All services</a>
        <a href="/services/ai-software-development/" class="text-xs font-mono text-[#00FF88] hover:underline bg-white/[0.03] px-3 py-1.5 rounded-lg border border-white/10">AI software development</a>
        <a href="/products/ai-automations/" class="text-xs font-mono text-[#00FF88] hover:underline bg-white/[0.03] px-3 py-1.5 rounded-lg border border-white/10">AI automations</a>
        <a href="/insights/ai-customer-support-agent-cost-australia/" class="text-xs font-mono text-[#00FF88] hover:underline bg-white/[0.03] px-3 py-1.5 rounded-lg border border-white/10">AI support agent costs</a>
      </div>
    </section>
  </main>
</Layout>
