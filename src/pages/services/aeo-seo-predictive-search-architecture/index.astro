          <div class="relative z-20">
            <p class="text-xs font-mono uppercase tracking-widest text-[#8FAF8F] mb-2">LoopBC</p>
            <p class="text-3xl md:text-4xl font-serif font-bold text-[#F0EDE6] group-hover:text-[#00FF88] transition-colors mb-2">15x Growth</p>
            <p class="text-xs font-mono text-[#00FF88]">380 &rarr; 5,763 Pages</p>
          </div>
          <div class="relative z-20 mt-6 pt-4 border-t border-white/5 text-[11px] font-mono text-muted-foreground">
            <a href="/insights/how-ai-predicted-campaign-roas-loopbc-marketing-agency/" class="hover:text-[#00FF88] transition-colors">
              Read LoopBC Case Study →
            </a>
          </div>
        </div>

        <!-- Card 3: PRESCIAIQ -->
        <div
          data-reveal="from-bottom"
          data-reveal-delay="200"
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-8 text-center transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 flex flex-col justify-between"
