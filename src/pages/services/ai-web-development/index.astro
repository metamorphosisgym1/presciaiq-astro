---
import Layout from '../../../layouts/Layout.astro';

const title = "AI Web Design and Development Australia | PresciaIQ";
const description = "High-performance AI web platforms built for Australian businesses. Predictive features, programmatic SEO architecture, and intelligent UX. From $5K, one-off.";
const canonicalURL = "https://www.presciaiq.com.au/services/ai-web-development/";
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AI Web Development Services Australia",
  "provider": {
    "@type": "Organization",
    "name": "PresciaIQ",
    "url": "https://www.presciaiq.com.au"
  },
  "areaServed": "Australia",
  "description": "PresciaIQ is an Australian AI web development company. We build high-performance, intelligent web platforms powered by predictive analytics and machine learning.",
  "dateModified": "2026-05-27",
  "relatedLink": [
    { "@type": "WebPage", "url": "https://www.presciaiq.com.au/insights/how-programmatic-seo-replaced-paid-ads-buildhire/", "name": "How Programmatic SEO Replaced Paid Ads for BuildHire" },
    { "@type": "WebPage", "url": "https://www.presciaiq.com.au/insights/what-is-aeo-answer-engine-optimisation-australia/", "name": "What is AEO — Answer Engine Optimisation in Australia" },
    { "@type": "WebPage", "url": "https://www.presciaiq.com.au/insights/cost-custom-software-development-australia-2026/", "name": "Cost of Custom Software Development in Australia 2026" },
    { "@type": "WebPage", "url": "https://www.presciaiq.com.au/industries/marketing-agencies/", "name": "AI for Marketing Agencies" },
    { "@type": "WebPage", "url": "https://www.presciaiq.com.au/services/ai-software-development/", "name": "AI for Trades Businesses" }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is AI web development?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AI web development is the creation of intelligent web platforms that use machine learning, predictive analytics, and natural language processing to automate user interactions, personalize content delivery, and forecast business outcomes. PresciaIQ builds AI-powered websites for Australian enterprises."
      }
    },
    {
      "@type": "Question",
      "name": "How does predictive AI improve a website?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Predictive AI improves a website by analyzing user behavior in real-time to anticipate their needs, optimizing the customer journey, reducing churn, and automating complex backend operations that traditional web platforms cannot handle."
      }
    },
    {
      "@type": "Question",
      "name": "Do you build e-commerce websites with AI?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, PresciaIQ integrates predictive intelligence into complex e-commerce and B2B portals to forecast demand, automate dynamic pricing, and personalize product recommendations at scale."
      }
    }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to get an AI-powered website built in Australia",
  "description": "A step-by-step guide to commissioning an AI web development project with PresciaIQ in Australia.",
  "totalTime": "PT8W",
  "estimatedCost": {
    "@type": "MonetaryAmount",
    "currency": "AUD",
    "value": "18000"
  },
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Book a discovery call",
      "text": "Schedule a 30-minute call with PresciaIQ to discuss your business goals, current tech stack, and what you want your web platform to achieve. We'll assess whether AI features and programmatic SEO are the right fit for your project.",
      "url": "https://www.presciaiq.com.au/start/"
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Receive a fixed-price proposal",
      "text": "Within 5 business days, you'll receive a detailed fixed-price proposal covering the full scope: design, development, AI feature integration, programmatic SEO architecture, and AEO schema implementation."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Design and development sprint",
      "text": "Our team builds your AI-powered web platform in a structured 6–12 week sprint. You'll receive weekly progress updates and a staging environment for review throughout the build."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Launch and SEO indexing",
      "text": "We deploy your site, submit the sitemap to Google Search Console, and ensure all programmatic SEO pages and AEO schema are correctly indexed. Organic traffic typically begins within 4–8 weeks of launch."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "90-day post-launch support",
      "text": "Every PresciaIQ web build includes 90 days of included post-launch support — covering bug fixes, performance optimisation, and SEO monitoring to ensure your site is generating leads from day one."
    }
  ]
}
</script>

<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <main class="relative bg-background text-foreground overflow-x-hidden min-h-screen">

    <!-- ═══ 1. ATMOSPHERIC GLOW BACKDROP ═══ -->
    <!-- Ambient: top-right mint radial glow -->
    <div
      class="pointer-events-none fixed inset-0 z-0 bg-[radial-gradient(ellipse_at_top_right,rgba(0,255,136,0.12),transparent_60%)]"
      aria-hidden="true"
    ></div>

    <!-- Subtle intelligence grid backdrop -->
    <div
      class="pointer-events-none fixed inset-0 z-0 grid-overlay opacity-60"
      aria-hidden="true"
    ></div>

    <!-- ═══ HERO WRAPPER ═══ -->
    <section class="relative z-10 border-b border-white/5">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-14 text-left md:text-center">

        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs text-muted-foreground font-mono mb-8 md:justify-center flex-wrap" aria-label="Breadcrumb">
          <a href="/" class="hover:text-primary transition-colors">Home</a>
          <span class="text-white/20">/</span>
          <a href="/development/" class="hover:text-primary transition-colors">Development</a>
          <span class="text-white/20">/</span>
          <span class="text-foreground">AI Web Development</span>
        </nav>

        <!-- Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-white/[0.04] text-xs font-mono uppercase tracking-[0.2em] text-[#00FF88] mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00FF88] shadow-[0_0_8px_#00FF88]"></span>
          CORE SERVICE
        </div>

        <!-- Title -->
        <h1 class="text-4xl md:text-6xl font-serif font-semibold text-[#F0EDE6] tracking-tight mb-6 leading-[1.1]">
          AI Web Design and Development <span class="text-[#00FF88] italic">in Australia</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-lg text-[#C9CCC8] font-sans leading-relaxed max-w-3xl mx-auto mb-8">
          A website is no longer just a digital brochure or a simple transactional storefront. We build high-performance web platforms engineered with machine learning, dynamic personalization, and predictive conversion architectures.
        </p>

        <p class="text-base text-[#8FAF8F] font-sans max-w-3xl mx-auto mb-8">Websites start from $5K, one-off. <a href="/pricing/" class="underline hover:text-[#F0EDE6]">See our pricing</a>. Meet our co-founders, <a href="/about/" class="underline hover:text-[#F0EDE6]">Alex Cutajar and Macauley Burke</a>.</p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/start/"
            id="hero-cta-web-start"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-[#00FF88] text-[#050508] font-semibold text-sm font-sans hover:bg-[#42FFAA] hover:shadow-[0_0_28px_rgba(0,255,136,0.45)] transition-all duration-300 hover:-translate-y-0.5"
          >
            Book Strategy Call →
          </a>
          <a
            href="#capabilities"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl border border-white/10 bg-white/[0.04] text-[#F0EDE6] font-semibold text-sm font-sans hover:border-[#00FF88]/40 hover:bg-white/[0.07] transition-all duration-300 backdrop-blur-md"
          >
            Explore Capabilities
          </a>
        </div>

      </div>
    </section>

    <!-- ═══ EXECUTIVE CALLOUT CARD: WHAT IS AI WEB DEVELOPMENT? ═══ -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-4">
      <div class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-8 border-l-4 border-l-[#00FF88] shadow-[0_10px_30px_rgba(0,0,0,0.3)] hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 transition-all duration-300">
        <!-- Light Shimmer -->
        <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
        
        <div class="relative z-20">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-[11px] font-mono uppercase tracking-[0.2em] text-[#00FF88] bg-[#00FF88]/10 px-2.5 py-0.5 rounded-full">
              Definition // Executive Summary
            </span>
          </div>
          <h2 class="text-xl md:text-2xl font-serif font-semibold text-[#F0EDE6] mb-3">
            What is AI Web Development?
          </h2>
          <p class="text-sm md:text-base text-[#C9CCC8] font-sans leading-relaxed">
            <strong class="text-white">AI web development</strong> is the creation of intelligent web platforms that use machine learning, predictive analytics, and natural language processing to automate user interactions, personalize content delivery, and forecast business outcomes. PresciaIQ builds AI-powered websites for Australian enterprises that require more than a static digital presence — platforms capable of learning, anticipating user intent, and actively driving commercial conversion.
          </p>
        </div>
      </div>
    </div>

    <!-- ═══ 2. PARADIGM SHIFT: THE END OF THE STATIC WEB ═══ -->
    <section class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-white/[0.03] text-[#8FAF8F] font-mono text-[11px] tracking-[0.2em] uppercase mb-4">
          PARADIGM EVOLUTION
        </div>
        <h2 class="text-3xl md:text-4xl font-serif font-semibold text-[#F0EDE6] tracking-tight mb-4">
          The End of the <span class="text-[#00FF88] italic">Static Web</span>
        </h2>
        <p class="text-[#C9CCC8] text-base font-sans leading-relaxed">
          Most agencies build passive brochure sites that rely on users to manually navigate, search, and decide. We engineer dynamic predictive web applications that adjust, recommend, and convert in real-time.
        </p>
      </div>

      <!-- Split Bento Comparison -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Left Card: Legacy Static Brochure Sites -->
        <div
          data-reveal="from-left"
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-8 hover:border-red-400/40 hover:shadow-[0_12px_35px_-8px_rgba(239,68,68,0.18)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
        >
          <!-- Light Shimmer -->
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>

          <div class="relative z-20">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono uppercase tracking-[0.18em] text-red-400/90 bg-red-400/10 px-3 py-1 rounded-full border border-red-400/20">
                Legacy Brochure Sites // Passive
              </span>
              <span class="text-white/30 text-xs font-mono">Traditional</span>
            </div>
            <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-3 group-hover:text-red-300 transition-colors">
              Static Pages &amp; High User Drop-Off
            </h3>
            <p class="text-[#C9CCC8] text-sm font-sans leading-relaxed mb-6">
              Traditional web agencies in Sydney and Melbourne build elegant yet dormant digital business cards. Content is identical for every visitor, user intent is ignored, and conversion forms remain passive — leaving teams trapped in <a href="/insights/where-operational-drag-hides/" class="text-[#00FF88] hover:underline underline-offset-4">reactive operational drag</a>.
            </p>
          </div>
          <ul class="relative z-20 space-y-2.5 pt-4 border-t border-white/5 text-xs font-mono text-[#8FAF8F]">
            <li class="flex items-center gap-2">
              <span class="text-red-400">✕</span> One-size-fits-all static pages
            </li>
            <li class="flex items-center gap-2">
              <span class="text-red-400">✕</span> Friction-heavy navigation journeys
            </li>
            <li class="flex items-center gap-2">
              <span class="text-red-400">✕</span> Zero real-time user intent detection
            </li>
          </ul>
        </div>

        <!-- Right Card: PresciaIQ Predictive AI Platforms -->
        <div
          data-reveal="from-right"
          class="group relative overflow-hidden rounded-2xl border border-[#00FF88]/30 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-8 hover:border-[#00FF88]/60 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
        >
          <!-- Ambient corner glow -->
          <div class="pointer-events-none absolute -top-16 -right-16 w-36 h-36 rounded-full bg-[#00FF88]/10 blur-2xl group-hover:bg-[#00FF88]/20 transition-all duration-500 z-0"></div>

          <!-- Light Shimmer -->
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>

          <div class="relative z-20">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono uppercase tracking-[0.18em] text-[#00FF88] bg-[#00FF88]/10 px-3 py-1 rounded-full border border-[#00FF88]/25">
                PresciaIQ Platforms // Predictive
              </span>
              <span class="text-[#00FF88] text-xs font-mono">Autonomous</span>
            </div>
            <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-3 group-hover:text-[#00FF88] transition-colors">
              Intelligent Dynamic Conversion Engines
            </h3>
            <p class="text-[#C9CCC8] text-sm font-sans leading-relaxed mb-6">
              We leverage modern ultra-fast frameworks (React, Next.js, Astro) paired with machine learning inference layers. Platforms detect customer intent, dynamically personalize value propositions, automate complex checkout workflows, and forecast buyer actions.
            </p>
          </div>
          <ul class="relative z-20 space-y-2.5 pt-4 border-t border-white/5 text-xs font-mono text-[#00FF88]">
            <li class="flex items-center gap-2">
              <span>✓</span> Autonomous user journey personalization
            </li>
            <li class="flex items-center gap-2">
              <span>✓</span> Real-time recommendation &amp; pricing engines
            </li>
            <li class="flex items-center gap-2">
              <span>✓</span> Sub-second response times with global CDN edge
            </li>
          </ul>
        </div>

      </div>
    </section>

    <!-- ═══ 3. BENTO GRID: OUR AI WEB CAPABILITIES (4 CORE CARDS) ═══ -->
    <section id="capabilities" class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 border-t border-white/5">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-white/[0.03] text-[#8FAF8F] font-mono text-[11px] tracking-[0.2em] uppercase mb-4">
          CORE PILLARS
        </div>
        <h2 class="text-3xl md:text-4xl font-serif font-semibold text-[#F0EDE6] tracking-tight mb-4">
          Our AI Web <span class="text-[#00FF88] italic">Capabilities</span>
        </h2>
        <p class="text-[#C9CCC8] text-base font-sans leading-relaxed">
          Four specialized web disciplines engineered for high-frequency user engagement, automated conversion, and machine learning scalability.
        </p>
      </div>

      <!-- 2x2 Bento Grid with Directional Reveal (Left from left, Right from right) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Card 1: Predictive B2B Portals (Left Column) -->
        <div
          data-reveal="from-left"
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-8 transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 flex flex-col justify-between"
        >
          <!-- Shimmer Overlay -->
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
          
          <div class="relative z-20">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#00FF88]">01 // B2B PORTALS</span>
              <span class="w-2 h-2 rounded-full bg-[#00FF88]/40 group-hover:bg-[#00FF88] transition-colors"></span>
            </div>
            <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-3 group-hover:text-[#00FF88] transition-colors">
              Predictive B2B Portals
            </h3>
            <p class="text-sm text-[#C9CCC8] font-sans leading-relaxed">
              Client and partner portals that forecast demand patterns, automate wholesale reordering, and surface real-time actionable intelligence tailored to each commercial stakeholder.
            </p>
          </div>
          <div class="relative z-20 mt-6 pt-4 border-t border-white/5 flex items-center text-xs font-mono text-[#8FAF8F]">
            <span>Demand forecasting &bull; Automated procurement &bull; Role-based telemetry</span>
          </div>
        </div>

        <!-- Card 2: Intelligent E-Commerce (Right Column) -->
        <div
          data-reveal="from-right"
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-8 transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 flex flex-col justify-between"
        >
          <!-- Shimmer Overlay -->
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
          
          <div class="relative z-20">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#00FF88]">02 // COMMERCE</span>
              <span class="w-2 h-2 rounded-full bg-[#00FF88]/40 group-hover:bg-[#00FF88] transition-colors"></span>
            </div>
            <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-3 group-hover:text-[#00FF88] transition-colors">
              Intelligent E-Commerce
            </h3>
            <p class="text-sm text-[#C9CCC8] font-sans leading-relaxed">
              Transactional platforms engineered with dynamic pricing models, predictive cart abandonment intervention, and contextual recommendation graphs designed to maximize average order value.
            </p>
          </div>
          <div class="relative z-20 mt-6 pt-4 border-t border-white/5 flex items-center text-xs font-mono text-[#8FAF8F]">
            <span>Dynamic pricing &bull; Churn preemption &bull; Contextual upsells</span>
          </div>
        </div>

        <!-- Card 3: Automated Web Workflows (Left Column) -->
        <div
          data-reveal="from-left"
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-8 transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 flex flex-col justify-between"
        >
          <!-- Shimmer Overlay -->
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
          
          <div class="relative z-20">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#00FF88]">03 // AUTOMATION</span>
              <span class="w-2 h-2 rounded-full bg-[#00FF88]/40 group-hover:bg-[#00FF88] transition-colors"></span>
            </div>
            <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-3 group-hover:text-[#00FF88] transition-colors">
              Automated Web Workflows
            </h3>
            <p class="text-sm text-[#C9CCC8] font-sans leading-relaxed">
              Web applications that eliminate repetitive data capture and document verification using natural language models and automated webhook orchestration directly inside the user interface.
            </p>
          </div>
          <div class="relative z-20 mt-6 pt-4 border-t border-white/5 flex items-center text-xs font-mono text-[#8FAF8F]">
            <span>Document verification &bull; Intelligent forms &bull; CRM sync</span>
          </div>
        </div>

        <!-- Card 4: High-Performance Architecture (Right Column) -->
        <div
          data-reveal="from-right"
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-8 transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 flex flex-col justify-between"
        >
          <!-- Shimmer Overlay -->
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
          
          <div class="relative z-20">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#00FF88]">04 // ARCHITECTURE</span>
              <span class="w-2 h-2 rounded-full bg-[#00FF88]/40 group-hover:bg-[#00FF88] transition-colors"></span>
            </div>
            <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-3 group-hover:text-[#00FF88] transition-colors">
              High-Performance Architecture
            </h3>
            <p class="text-sm text-[#C9CCC8] font-sans leading-relaxed">
              Sub-second static site generation with on-demand edge rendering. Structured to handle high-concurrency traffic, real-time AI model calls, and programmatic SEO indexation for tens of thousands of landing pages.
            </p>
          </div>
          <div class="relative z-20 mt-6 pt-4 border-t border-white/5 flex items-center text-xs font-mono text-[#8FAF8F]">
            <span>Edge compute &bull; Programmatic SEO &bull; Sub-second TTFB</span>
          </div>
        </div>

      </div>
    </section>

    <!-- ═══ 4. TRANSFORMATIVE CALLOUT STATEMENT ═══ -->
    <section class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div
        data-reveal="from-bottom"
        class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-10 flex flex-col md:flex-row items-center justify-between gap-6 hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] transition-all duration-300"
