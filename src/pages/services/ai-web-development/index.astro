  <!-- ═══ DIRECTIONAL SCROLL REVEAL SCRIPT ═══ -->
  <script is:inline>
    (function () {
      const INIT = {
        'from-left':   { transform: 'translateX(-20px)', opacity: '0' },
        'from-right':  { transform: 'translateX(20px)',  opacity: '0' },
        'from-bottom': { transform: 'translateY(20px)',  opacity: '0' },
      };

      const targets = document.querySelectorAll('[data-reveal]');

      // Apply initial hidden state without flash
      targets.forEach(el => {
        const dir = el.getAttribute('data-reveal');
        const init = INIT[dir];
        if (!init) return;
        Object.assign(el.style, init);
        el.style.transition = 'transform 400ms cubic-bezier(0.16, 1, 0.3, 1), opacity 400ms cubic-bezier(0.16, 1, 0.3, 1)';
        el.style.willChange = 'transform, opacity';
      });

      // Observe and reveal on scroll
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const el = entry.target;
            const delay = parseInt(el.getAttribute('data-reveal-delay') || '0', 10);
            setTimeout(() => {
              el.style.transform = 'translate(0, 0)';
              el.style.opacity = '1';
            }, delay);
            observer.unobserve(el);
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      targets.forEach(el => observer.observe(el));

      // Accessibility: skip animations for prefers-reduced-motion
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        targets.forEach(el => {
          el.style.transform = 'none';
          el.style.opacity = '1';
          el.style.transition = 'none';
        });
      }
    })();
  </script>
