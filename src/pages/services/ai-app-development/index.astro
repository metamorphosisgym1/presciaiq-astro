---
import Layout from '../../../layouts/Layout.astro';

const title = "AI App Development Australia | PresciaIQ";
const description = "Build intelligent mobile and web apps powered by predictive AI. PresciaIQ delivers custom AI app development for Australian businesses. From $15K.";
const canonicalURL = "https://www.presciaiq.com.au/services/ai-app-development/";
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AI App Development Services Australia",
  "provider": {
    "@type": "Organization",
    "name": "PresciaIQ",
    "url": "https://www.presciaiq.com.au"
  },
  "areaServed": "Australia",
  "description": "PresciaIQ is an Australian AI app development company. We build intelligent mobile and web applications powered by machine learning and predictive analytics.",
  "dateModified": "2026-05-27",
  "relatedLink": [
    { "@type": "WebPage", "url": "https://www.presciaiq.com.au/insights/building-ai-health-app-australia-longevityaus/", "name": "Building an AI Health App in Australia" },
    { "@type": "WebPage", "url": "https://www.presciaiq.com.au/insights/best-ai-tools-small-business-australia/", "name": "Best AI Tools for Small Business in Australia" },
    { "@type": "WebPage", "url": "https://www.presciaiq.com.au/insights/cost-custom-software-development-australia-2026/", "name": "Cost of Custom Software Development in Australia 2026" },
    { "@type": "WebPage", "url": "https://www.presciaiq.com.au/industries/construction/", "name": "AI for Construction & Property" },
    { "@type": "WebPage", "url": "https://www.presciaiq.com.au/industries/financial-services/", "name": "AI for Financial Services" }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is an AI-powered app?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An AI-powered app is a mobile or web application that integrates machine learning models, predictive analytics, or natural language processing to automate tasks, personalize user experiences, or forecast outcomes. PresciaIQ builds AI apps for Australian businesses that need more than just a digital brochure."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to build an AI app?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Building a custom AI app typically takes 3 to 6 months. This timeline includes data modeling, machine learning integration, UI/UX design, and rigorous testing to ensure the predictive models function accurately in real-world scenarios."
      }
    },
    {
      "@type": "Question",
      "name": "Can you add AI to an existing app?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. PresciaIQ frequently audits existing mobile and web applications to identify where predictive intelligence can be integrated to reduce churn, automate support, or optimize operations."
      }
    },
    {
      "@type": "Question",
      "name": "What frameworks do you build AI apps with?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We engineer cross-platform mobile and web applications using React Native, Flutter, Swift (iOS), Kotlin (Android), and high-performance modern web stacks with embedded on-device or cloud inference pipelines."
      }
    }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to get an AI-powered app built in Australia",
  "description": "A step-by-step guide to commissioning an AI app development project with PresciaIQ in Australia.",
  "totalTime": "PT10W",
  "estimatedCost": {
    "@type": "MonetaryAmount",
    "currency": "AUD",
    "value": "25000"
  },
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Book a discovery call",
      "text": "Schedule a 30-minute call with PresciaIQ to discuss your app concept, target users, and what AI features you want built in. We'll assess the right platform (iOS, Android, web app) and scope for your budget.",
      "url": "https://www.presciaiq.com.au/start/"
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Receive a fixed-price proposal",
      "text": "Within 5 business days, you'll receive a detailed fixed-price proposal covering UX design, development, AI feature integration, and post-launch support. No variable scope, no surprise invoices."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "UX design and prototype review",
      "text": "Before a single line of code is written, you'll review and approve the full UX design and interactive prototype. This ensures the app matches your vision before development begins."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Development and AI integration sprint",
      "text": "Our team builds your app in a structured 8–16 week sprint, integrating AI features such as predictive recommendations, natural language processing, or computer vision as scoped in your proposal."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Launch, app store submission, and support",
      "text": "We handle app store submission for iOS and Android, configure analytics, and provide 90 days of included post-launch support to ensure your app is performing from day one."
    }
  ]
}
</script>

<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <main class="relative bg-background text-foreground overflow-x-hidden min-h-screen">

    <!-- ═══ 1. ATMOSPHERIC GLOW BACKDROP ═══ -->
    <!-- Ambient: top-right mint radial glow -->
    <div
      class="pointer-events-none fixed inset-0 z-0 bg-[radial-gradient(ellipse_at_top_right,rgba(0,255,136,0.12),transparent_60%)]"
      aria-hidden="true"
    ></div>

    <!-- Subtle intelligence grid backdrop -->
    <div
      class="pointer-events-none fixed inset-0 z-0 grid-overlay opacity-60"
      aria-hidden="true"
    ></div>

    <!-- ═══ HERO WRAPPER ═══ -->
    <section class="relative z-10 border-b border-white/5">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-14 text-left md:text-center">

        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs text-muted-foreground font-mono mb-8 md:justify-center flex-wrap" aria-label="Breadcrumb">
          <a href="/" class="hover:text-primary transition-colors">Home</a>
          <span class="text-white/20">/</span>
          <a href="/development/" class="hover:text-primary transition-colors">Development</a>
          <span class="text-white/20">/</span>
          <span class="text-foreground">AI App Development</span>
        </nav>

        <!-- Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-white/[0.04] text-xs font-mono uppercase tracking-[0.2em] text-[#00FF88] mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00FF88] shadow-[0_0_8px_#00FF88]"></span>
          CORE SERVICE
        </div>

        <!-- Title -->
        <h1 class="text-4xl md:text-6xl font-serif font-semibold text-[#F0EDE6] tracking-tight mb-6 leading-[1.1]">
          AI App Development <span class="text-[#00FF88] italic">in Australia</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-lg text-[#C9CCC8] font-sans leading-relaxed max-w-3xl mx-auto mb-8">
          The app market is saturated with static applications that merely digitize manual forms. We architect intelligent mobile and web applications embedded with predictive machine learning that anticipate user needs and drive measurable operational ROI.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/start/"
            id="hero-cta-app-start"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-[#00FF88] text-[#050508] font-semibold text-sm font-sans hover:bg-[#42FFAA] hover:shadow-[0_0_28px_rgba(0,255,136,0.45)] transition-all duration-300 hover:-translate-y-0.5"
          >
            Book Strategy Call →
          </a>
          <a
            href="#capabilities"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl border border-white/10 bg-white/[0.04] text-[#F0EDE6] font-semibold text-sm font-sans hover:border-[#00FF88]/40 hover:bg-white/[0.07] transition-all duration-300 backdrop-blur-md"
          >
            Explore Capabilities
          </a>
        </div>

      </div>
    </section>

    <!-- ═══ EXECUTIVE HERO SUMMARY CALLOUT ═══ -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-4">
      <div class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-8 border-l-4 border-l-[#00FF88] shadow-[0_10px_30px_rgba(0,0,0,0.3)] hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 transition-all duration-300">
        <!-- Light Shimmer -->
        <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
        
        <div class="relative z-20">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-[11px] font-mono uppercase tracking-[0.2em] text-[#00FF88] bg-[#00FF88]/10 px-2.5 py-0.5 rounded-full">
              Definition // Executive Architecture
            </span>
          </div>
          <h2 class="text-xl md:text-2xl font-serif font-semibold text-[#F0EDE6] mb-3">
            What is AI App Development?
          </h2>
          <p class="text-sm md:text-base text-[#C9CCC8] font-sans leading-relaxed">
            <strong class="text-white">AI app development</strong> is the creation of mobile and web applications that integrate machine learning, predictive analytics, and autonomous automation to learn continuously from user telemetry and anticipate needs. PresciaIQ is an Australian AI app engineering company building intelligent applications that transform software from passive cost centers into high-margin profit drivers.
          </p>
        </div>
      </div>
    </div>

    <!-- ═══ 2. PARADIGM SHIFT: INTELLIGENCE BUILT IN, NOT BOLTED ON ═══ -->
    <section class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-white/[0.03] text-[#8FAF8F] font-mono text-[11px] tracking-[0.2em] uppercase mb-4">
          ARCHITECTURAL PARADIGM
        </div>
        <h2 class="text-3xl md:text-4xl font-serif font-semibold text-[#F0EDE6] tracking-tight mb-4">
          Intelligence Built In, <span class="text-[#00FF88] italic">Not Bolted On</span>
        </h2>
        <p class="text-[#C9CCC8] text-base font-sans leading-relaxed">
          Most mobile developers bolt an external chatbot API onto a generic UI. We engineer custom neural architectures and probabilistic prediction directly into the application runtime.
        </p>
      </div>

      <!-- Split Bento Comparison (2 Cards) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Left Card: Generic Front-End Wrapper Apps -->
        <div
          data-reveal="from-left"
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-8 hover:border-red-400/40 hover:shadow-[0_12px_35px_-8px_rgba(239,68,68,0.18)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
        >
          <!-- Shimmer Overlay -->
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>

          <div class="relative z-20">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono uppercase tracking-[0.18em] text-red-400/90 bg-red-400/10 px-3 py-1 rounded-full border border-red-400/20">
                Generic Wrapper Apps // Superficial
              </span>
              <span class="text-white/30 text-xs font-mono">Traditional</span>
            </div>
            <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-3 group-hover:text-red-300 transition-colors">
              Brittle API Wrappers &amp; High Latency
            </h3>
            <p class="text-[#C9CCC8] text-sm font-sans leading-relaxed mb-6">
              Standard app agencies focus purely on superficial visual wrappers. They pass user data to generic third-party cloud APIs with zero proprietary differentiation, creating uncontrollable API cost drains, severe latency bottlenecks, and unmanaged Australian privacy risks.
            </p>
          </div>
          <ul class="relative z-20 space-y-2.5 pt-4 border-t border-white/5 text-xs font-mono text-[#8FAF8F]">
            <li class="flex items-center gap-2">
              <span class="text-red-400">✕</span> Escalating third-party token &amp; inference fees
            </li>
            <li class="flex items-center gap-2">
              <span class="text-red-400">✕</span> Zero IP ownership or proprietary model weights
            </li>
            <li class="flex items-center gap-2">
              <span class="text-red-400">✕</span> Brittle user experience during network dropouts
            </li>
          </ul>
        </div>

        <!-- Right Card: PresciaIQ Autonomous Edge & Native Intelligence -->
        <div
          data-reveal="from-right"
          class="group relative overflow-hidden rounded-2xl border border-[#00FF88]/30 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-8 hover:border-[#00FF88]/60 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
        >
          <!-- Ambient corner glow -->
          <div class="pointer-events-none absolute -top-16 -right-16 w-36 h-36 rounded-full bg-[#00FF88]/10 blur-2xl group-hover:bg-[#00FF88]/20 transition-all duration-500 z-0"></div>

          <!-- Shimmer Overlay -->
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>

          <div class="relative z-20">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono uppercase tracking-[0.18em] text-[#00FF88] bg-[#00FF88]/10 px-3 py-1 rounded-full border border-[#00FF88]/25">
                PresciaIQ Architecture // Autonomous
              </span>
              <span class="text-[#00FF88] text-xs font-mono">Native Edge</span>
            </div>
            <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-3 group-hover:text-[#00FF88] transition-colors">
              Embedded Inference &amp; Data Sovereignty
            </h3>
            <p class="text-[#C9CCC8] text-sm font-sans leading-relaxed mb-6">
              We design native edge and hybrid cloud runtimes tailored for Australian enterprise data compliance. Predictive scoring runs with sub-millisecond responsiveness, allowing field workers and executives to automate actions even in remote, offline environments.
            </p>
          </div>
          <ul class="relative z-20 space-y-2.5 pt-4 border-t border-white/5 text-xs font-mono text-[#00FF88]">
            <li class="flex items-center gap-2">
              <span>✓</span> Embedded on-device &amp; private cloud inference
            </li>
            <li class="flex items-center gap-2">
              <span>✓</span> Strict Australian data sovereignty &amp; compliance
            </li>
            <li class="flex items-center gap-2">
              <span>✓</span> Compounding competitive moat via proprietary models
            </li>
          </ul>
        </div>

      </div>
    </section>

    <!-- ═══ 3. BENTO GRID: OUR AI APP CAPABILITIES (4 CARDS) ═══ -->
    <section id="capabilities" class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 border-t border-white/5">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-white/[0.03] text-[#8FAF8F] font-mono text-[11px] tracking-[0.2em] uppercase mb-4">
          ENGINEERING PILLARS
        </div>
        <h2 class="text-3xl md:text-4xl font-serif font-semibold text-[#F0EDE6] tracking-tight mb-4">
          Our AI App <span class="text-[#00FF88] italic">Capabilities</span>
        </h2>
        <p class="text-[#C9CCC8] text-base font-sans leading-relaxed">
          Four core disciplines built to deliver native mobile fluidity, predictive user foresight, and enterprise robustness.
        </p>
      </div>

      <!-- 2x2 Bento Grid with Directional Reveal (Left from left, Right from right) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Card 1: Predictive User Experiences (Left Column) -->
        <div
          data-reveal="from-left"
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-8 transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 flex flex-col justify-between"
        >
          <!-- Shimmer Overlay -->
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
          
          <div class="relative z-20">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#00FF88]">01 // ADAPTIVE UX</span>
              <span class="w-2 h-2 rounded-full bg-[#00FF88]/40 group-hover:bg-[#00FF88] transition-colors"></span>
            </div>
            <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-3 group-hover:text-[#00FF88] transition-colors">
              Predictive User Experiences
            </h3>
            <p class="text-sm text-[#C9CCC8] font-sans leading-relaxed">
              Applications that dynamically morph their interfaces, shortcuts, and contextual recommendations based on individual behavioral telemetry and probabilistic Bayesian modeling.
            </p>
          </div>
          <div class="relative z-20 mt-6 pt-4 border-t border-white/5 flex items-center text-xs font-mono text-[#8FAF8F]">
            <span>Dynamic UI &bull; Intent prediction &bull; Cognitive fatigue reduction</span>
          </div>
        </div>

        <!-- Card 2: Intelligent Automation (Right Column) -->
        <div
          data-reveal="from-right"
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-8 transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 flex flex-col justify-between"
        >
          <!-- Shimmer Overlay -->
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
          
          <div class="relative z-20">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#00FF88]">02 // AUTOMATION</span>
              <span class="w-2 h-2 rounded-full bg-[#00FF88]/40 group-hover:bg-[#00FF88] transition-colors"></span>
            </div>
            <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-3 group-hover:text-[#00FF88] transition-colors">
              Intelligent Automation
            </h3>
            <p class="text-sm text-[#C9CCC8] font-sans leading-relaxed">
              Mobile workflows that automate data capture, optical character verification, and field decision-making for remote workforces, construction managers, and clinical operators.
            </p>
          </div>
          <div class="relative z-20 mt-6 pt-4 border-t border-white/5 flex items-center text-xs font-mono text-[#8FAF8F]">
            <span>OCR &amp; computer vision &bull; Field data sync &bull; Zero manual entry</span>
          </div>
        </div>

        <!-- Card 3: Cross-Platform Excellence (Left Column) -->
        <div
          data-reveal="from-left"
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-8 transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 flex flex-col justify-between"
        >
          <!-- Shimmer Overlay -->
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
          
          <div class="relative z-20">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#00FF88]">03 // CROSS-PLATFORM</span>
              <span class="w-2 h-2 rounded-full bg-[#00FF88]/40 group-hover:bg-[#00FF88] transition-colors"></span>
            </div>
            <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-3 group-hover:text-[#00FF88] transition-colors">
              Cross-Platform Excellence
            </h3>
            <p class="text-sm text-[#C9CCC8] font-sans leading-relaxed">
              Engineered with modern frameworks (React Native, Flutter, Swift, Kotlin) delivering 60 FPS performance, low battery footprint, and unified business logic across iOS, Android, and web.
            </p>
          </div>
          <div class="relative z-20 mt-6 pt-4 border-t border-white/5 flex items-center text-xs font-mono text-[#8FAF8F]">
            <span>iOS &amp; Android native &bull; Unified codebase &bull; 60 FPS rendering</span>
          </div>
        </div>

        <!-- Card 4: AI Integration & APIs (Right Column) -->
        <div
          data-reveal="from-right"
          class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-8 transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 flex flex-col justify-between"
        >
          <!-- Shimmer Overlay -->
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
          
          <div class="relative z-20">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#00FF88]">04 // INTEGRATION</span>
              <span class="w-2 h-2 rounded-full bg-[#00FF88]/40 group-hover:bg-[#00FF88] transition-colors"></span>
            </div>
            <h3 class="text-xl font-serif font-semibold text-[#F0EDE6] mb-3 group-hover:text-[#00FF88] transition-colors">
              AI Integration &amp; APIs
            </h3>
            <p class="text-sm text-[#C9CCC8] font-sans leading-relaxed">
              Seamless low-latency connections to custom private models, vector stores, and enterprise ERP/CRM pipelines, transforming your mobile app into an active operational node.
            </p>
          </div>
          <div class="relative z-20 mt-6 pt-4 border-t border-white/5 flex items-center text-xs font-mono text-[#8FAF8F]">
            <span>Private vector embeddings &bull; ERP synchronization &bull; Real-time pub/sub</span>
          </div>
        </div>

      </div>
    </section>

    <!-- ═══ 4. STATEMENT BANNER: STOP BUILDING STATIC APPS ═══ -->
    <section class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div
        data-reveal="from-bottom"
        class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 md:p-10 flex flex-col md:flex-row items-center justify-between gap-6 hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] transition-all duration-300"
      >
        <!-- Shimmer Overlay -->
