---
import Layout from '../../layouts/Layout.astro';
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AEO/SEO — Predictive Search Architecture",
  "provider": {
    "@type": "Organization",
    "name": "PresciaIQ",
    "url": "https://www.presciaiq.com.au"
  },
  "areaServed": "Australia",
  "description": "PresciaIQ provides programmatic SEO and AEO (Answer Engine Optimisation) architecture. We map every service, industry, location, and persona to build thousands of targeted, AI-optimised pages in a single deployment, generating compounding structural authority with zero ongoing ad spend.",
  "offers": {
    "@type": "Offer",
    "price": "4999.00",
    "priceCurrency": "AUD"
  },
  "dateModified": "2026-05-27",
  "relatedLink": [
    { "@type": "WebPage", "url": "https://www.presciaiq.com.au/insights/how-programmatic-seo-replaced-paid-ads-buildhire/", "name": "How Programmatic SEO Replaced Paid Ads for BuildHire" },
    { "@type": "WebPage", "url": "https://www.presciaiq.com.au/insights/what-is-aeo-answer-engine-optimisation-australia/", "name": "What is AEO — Answer Engine Optimisation in Australia" },
    { "@type": "WebPage", "url": "https://www.presciaiq.com.au/insights/how-ai-predicted-campaign-roas-loopbc-marketing-agency/", "name": "How AI Predicted Campaign ROAS for LoopBC" },
    { "@type": "WebPage", "url": "https://www.presciaiq.com.au/industries/marketing-agencies/", "name": "AI for Marketing Agencies" },
