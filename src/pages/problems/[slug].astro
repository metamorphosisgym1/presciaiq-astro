---
import Layout from '../../layouts/Layout.astro';
import { problems } from '../../data/problems';

export function getStaticPaths() {
  return problems.map(problem => ({
    params: { slug: problem.slug },
    props: { problem },
  }));
}

const { problem } = Astro.props;

const title = `${problem.problemTitle} | PresciaIQ`;
const description = `Discover how Australian ${problem.industry.toLowerCase()} businesses use predictive AI to solve ${problem.problemShort.toLowerCase()} before it impacts operations.`;
const canonicalURL = `https://www.presciaiq.com.au/problems/${problem.slug}/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.presciaiq.com.au" },
    { "@type": "ListItem", "position": 2, "name": "Problems", "item": "https://www.presciaiq.com.au/problems" },
    { "@type": "ListItem", "position": 3, "name": problem.problemTitle, "item": canonicalURL }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": problem.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <div class="pt-32 pb-24 min-h-screen">
    <div class="max-w-3xl mx-auto px-6">
      
      <div class="glass-card p-8 md:p-12">
        <div class="flex flex-wrap gap-4 mb-6 text-sm text-gray-400 font-sans">
          <span class="text-[#00ff88] font-semibold uppercase tracking-widest text-xs">{problem.industry}</span>
          <span>&bull; Operational Intelligence</span>
        </div>

        <h1 class="font-display text-3xl md:text-4xl font-bold text-white mb-8 leading-tight">{problem.problemTitle}</h1>
        
        <div class="prose prose-invert prose-lg max-w-none font-sans text-gray-400 leading-relaxed">
          
          <h2 class="font-display text-2xl font-bold text-white mt-10 mb-4">The Problem</h2>
          <div class="bg-black/40 border-l-4 border-red-500/50 p-6 mb-8 rounded-r-lg">
            <p class="mb-4"><strong>The Symptom:</strong> {problem.symptom}</p>
            <p class="mb-4"><strong>The Root Cause:</strong> {problem.rootCause}</p>
            <p class="text-white"><strong>The Cost:</strong> {problem.cost}</p>
          </div>

          <h2 class="font-display text-2xl font-bold text-white mt-10 mb-4">The Predictive AI Solution</h2>
          <div class="bg-black/40 border-l-4 border-[#00ff88] p-6 mb-8 rounded-r-lg">
            <p class="mb-4"><strong>How It Works:</strong> {problem.solution}</p>
            <p class="text-white"><strong>The Outcome:</strong> {problem.outcome}</p>
          </div>

          <h2 class="font-display text-2xl font-bold text-white mt-12 mb-6">Frequently Asked Questions</h2>
          <div class="space-y-8 mb-12">
            {problem.faqs.map(faq => (
              <div>
                <h3 class="font-display text-xl font-semibold text-white mb-3">{faq.q}</h3>
                <p>{faq.a}</p>
              </div>
            ))}
          </div>

          <div class="mt-12 pt-8 border-t border-white/10">
            <div class="bg-gradient-to-r from-[#00ff88]/20 to-transparent p-8 rounded-xl border border-[#00ff88]/30">
              <h3 class="text-2xl font-bold text-white mb-4">Stop reacting. Start predicting.</h3>
              <p class="text-gray-300 mb-6">Learn how PresciaIQ can help your {problem.industry.toLowerCase()} business eliminate the Reaction Tax and predict {problem.problemShort.toLowerCase()} before it happens.</p>
              <a href="/contact" class="inline-block bg-[#00ff88] text-black font-bold px-8 py-4 rounded-lg hover:bg-[#00ff88]/90 transition-colors">
                Book a Strategy Call
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
