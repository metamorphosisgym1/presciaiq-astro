---
import Layout from '../../layouts/Layout.astro';

const title = "AI for Construction Australia | PresciaIQ";
const description = "Predict construction cost overruns, timeline blowouts, and subcontractor risk before they happen. PresciaIQ's BuildPredictIQ for Australian builders.";
const canonicalURL = new URL("/industries/construction/", Astro.site).href;

const faqs = [
  {
    q: "How does BuildPredictIQ predict construction cost overruns?",
    a: "BuildPredictIQ analyses 47 risk variables including weather patterns, subcontractor performance history, material lead times, council approval timelines, and site complexity scores. The engine cross-references these against a dataset of 12,000+ Australian construction projects to produce a risk-adjusted cost forecast with a confidence interval."
  },
  {
    q: "What size construction projects is PresciaIQ suited for?",
    a: "BuildPredictIQ is optimised for projects between $500K and $50M — residential developments, commercial fitouts, civil works, and infrastructure projects. For projects above $50M, we offer a custom enterprise integration with your existing project management software."
  },
  {
    q: "How long does it take to implement BuildPredictIQ?",
    a: "For a standard integration with your existing project management data (Procore, Aconex, or spreadsheet-based), implementation takes 4–6 weeks. The AI engine begins producing predictions from week 3 as it ingests your historical project data."
  },
  {
    q: "Does PresciaIQ integrate with Procore or Aconex?",
    a: "Yes. BuildPredictIQ has native API integrations with Procore and Aconex, and supports CSV import from any project management system. Our team handles the integration as part of onboarding."
  },
  {
    q: "What ROI can a construction company expect from predictive AI?",
    a: "Based on our Australian client data, construction companies using BuildPredictIQ reduce cost overruns by an average of 23% and improve tender win rates by 18% through more accurate pricing. For a company turning over $10M in projects annually, this typically represents $400K–$800K in recovered margin."
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": title,
      "description": description,
      "url": canonicalURL,
      "dateModified": "2026-05-27",
      "relatedLink": [
      { "@type": "WebPage", "url": "https://www.presciaiq.com.au/insights/ai-construction-risk-assessment-australia/", "name": "AI Construction Risk Assessment in Australia" },
      { "@type": "WebPage", "url": "https://www.presciaiq.com.au/insights/eliminate-construction-budget-blowouts-ai/", "name": "Eliminate Construction Budget Blowouts with AI" },
      { "@type": "WebPage", "url": "https://www.presciaiq.com.au/insights/the-reaction-tax/", "name": "The Reaction Tax" }
      ],
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.presciaiq.com.au/" },
          { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://www.presciaiq.com.au/industries/" },
          { "@type": "ListItem", "position": 3, "name": "Construction & Property", "item": canonicalURL }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    },
    {
      "@type": "SpeakableSpecification",
      "cssSelector": ["h1", ".speakable-summary"]
    }
  ]
};
---

<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="min-h-screen bg-background text-foreground">
    <!-- Breadcrumb -->
    <div class="border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <nav class="flex items-center gap-2 text-sm text-muted-foreground font-sans flex-wrap">
          <a href="/" class="hover:text-primary transition-colors">Home</a>
          <span>/</span>
          <a href="/industries/" class="hover:text-primary transition-colors">Industries</a>
          <span>/</span>
          <span class="text-foreground">Construction & Property</span>
        </nav>
      </div>
    </div>

    <!-- Hero -->
    <section class="py-16 md:py-24 border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-3 mb-6">
          <span class="text-xs uppercase tracking-[0.25em] text-primary font-sans font-semibold">Construction & Property</span>
          <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold text-primary border border-primary/20 bg-primary/5">BuildPredictIQ</span>
        </div>
        <h1 class="font-display text-4xl md:text-6xl font-bold text-foreground mb-6 leading-tight max-w-4xl">
          Predict Project Risk <span class="text-gradient-primary">Before It Costs You</span>
        </h1>
        <p class="speakable-summary text-lg text-muted-foreground font-sans max-w-2xl leading-relaxed mb-8">
          Australian construction projects run 20–30% over budget on average. BuildPredictIQ analyses 47 risk variables — weather, subcontractor history, material lead times, and site complexity — to predict cost and timeline risk before a single sod is turned.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/start/" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-primary text-primary-foreground font-semibold text-sm font-sans hover:shadow-[0_0_20px_rgba(0,255,136,0.3)] transition-all duration-500">
            Run a Free Risk Assessment →
          </a>
          <a href="/products/buildpredictiq/" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl border border-white/10 text-foreground font-semibold text-sm font-sans hover:border-primary/30 transition-all">
            View BuildPredictIQ →
          </a>
        </div>
      </div>
    </section>

    <!-- The Problem -->
    <section class="py-16 border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12 items-start">
          <div>
            <p class="text-xs uppercase tracking-[0.25em] text-primary font-sans font-semibold mb-4">The Problem</p>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground mb-6">Construction Runs on Gut Feel. That's Expensive.</h2>
            <p class="text-muted-foreground font-sans leading-relaxed mb-4">
              Most Australian construction companies price tenders based on experience and spreadsheets. When a subcontractor goes under, when council approvals blow out by 6 weeks, or when steel prices spike 18% — the margin evaporates and the project becomes a liability.
            </p>
            <p class="text-muted-foreground font-sans leading-relaxed mb-4">
              The problem isn't that these risks are unpredictable. It's that the data to predict them exists — in your past projects, in public weather records, in subcontractor payment histories, in council approval databases — but no one has connected it into a prediction engine.
            </p>
            <p class="text-muted-foreground font-sans leading-relaxed">
              BuildPredictIQ connects that data. For the first time, Australian construction companies can price with confidence, not hope.
            </p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { stat: "23%", label: "Average cost overrun reduction" },
              { stat: "18%", label: "Tender win rate improvement" },
              { stat: "47", label: "Risk variables analysed per project" },
              { stat: "89%", label: "Prediction accuracy on 3-month forecasts" },
            ].map(item => (
              <div class="rounded-xl p-6 border border-white/8" style="background: rgba(255,255,255,0.02);">
                <p class="font-mono text-3xl font-bold text-primary mb-2">{item.stat}</p>
                <p class="text-sm text-muted-foreground font-sans leading-snug">{item.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="py-16 border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-xs uppercase tracking-[0.25em] text-primary font-sans font-semibold mb-4">How It Works</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground mb-12 max-w-2xl">From Project Brief to Risk-Adjusted Forecast in 72 Hours</h2>
        <div class="grid md:grid-cols-3 gap-8">
          {[
            {
              step: "01",
              title: "Data Ingestion",
              desc: "We connect BuildPredictIQ to your existing project data — Procore, Aconex, or CSV export. The engine ingests your historical project outcomes, subcontractor records, and site data."
            },
            {
              step: "02",
              title: "Risk Modelling",
              desc: "The AI cross-references your project parameters against 12,000+ Australian construction projects, current material pricing, BOM weather forecasts, and council approval timelines for your LGA."
            },
            {
              step: "03",
              title: "Predictive Output",
              desc: "You receive a risk-adjusted cost forecast, a timeline confidence interval, and a ranked list of the top 5 risk factors for your specific project — with recommended mitigation actions."
            },
          ].map(step => (
            <div class="relative">
              <p class="font-mono text-5xl font-bold text-primary/20 mb-4">{step.step}</p>
              <h3 class="font-display text-xl font-bold text-foreground mb-3">{step.title}</h3>
              <p class="text-muted-foreground font-sans leading-relaxed text-sm">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Case Study -->
    <section class="py-16 border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-xs uppercase tracking-[0.25em] text-primary font-sans font-semibold mb-4">Case Study</p>
        <div class="rounded-2xl border border-primary/20 p-8 md:p-12" style="background: rgba(0,255,136,0.02);">
          <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground mb-4">
            How BuildHire Used pSEO Architecture to Build a 84,000-Page Organic Presence
          </h2>
          <p class="text-muted-foreground font-sans leading-relaxed mb-6 max-w-3xl">
            BuildHire, an equipment hire company serving NSW construction sites, had zero organic search presence — all leads came from paid ads at $45–$90 cost per click. PresciaIQ built a full programmatic SEO architecture covering every equipment type, 83 NSW locations, and 12 construction industry sub-sectors.
          </p>
          <div class="grid sm:grid-cols-3 gap-6 mb-8">
            {[
              { metric: "84,000", label: "Organic pages deployed" },
              { metric: "$0", label: "Ongoing cost per organic visit" },
              { metric: "83", label: "NSW locations covered" },
            ].map(m => (
              <div>
                <p class="font-mono text-3xl font-bold text-primary mb-1">{m.metric}</p>
                <p class="text-sm text-muted-foreground font-sans">{m.label}</p>
              </div>
            ))}
          </div>
          <a href="/insights/case-studies/buildhire/" class="inline-flex items-center gap-2 text-primary font-sans font-semibold text-sm hover:gap-3 transition-all">
            Read the full BuildHire case study →
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 border-b border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-xs uppercase tracking-[0.25em] text-primary font-sans font-semibold mb-4">Frequently Asked Questions</p>
        <h2 class="font-display text-3xl font-bold text-foreground mb-10">Construction AI — Common Questions</h2>
        <div class="space-y-6 max-w-3xl">
          {faqs.map(faq => (
            <div class="border-b border-white/5 pb-6">
              <h3 class="font-display text-lg font-bold text-foreground mb-3">{faq.q}</h3>
              <p class="text-muted-foreground font-sans leading-relaxed text-sm">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Related -->
    <section class="py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-xs uppercase tracking-[0.25em] text-primary font-sans font-semibold mb-6">Related</p>
        <div class="grid sm:grid-cols-3 gap-4">
          <a href="/products/buildpredictiq/" class="rounded-xl border border-white/8 p-5 hover:border-primary/30 transition-all" style="background: rgba(255,255,255,0.02);">
            <p class="font-mono text-xs text-primary mb-2">Product</p>
            <p class="font-display font-bold text-foreground">BuildPredictIQ →</p>
          </a>
          <a href="/answers/how-does-ai-help-construction-risk-management-australia/" class="rounded-xl border border-white/8 p-5 hover:border-primary/30 transition-all" style="background: rgba(255,255,255,0.02);">
            <p class="font-mono text-xs text-primary mb-2">Answer</p>
            <p class="font-display font-bold text-foreground">AI & Construction Risk →</p>
          </a>
          <a href="/insights/ai-construction-risk-assessment-australia/" class="rounded-xl border border-white/8 p-5 hover:border-primary/30 transition-all" style="background: rgba(255,255,255,0.02);">
            <p class="font-mono text-xs text-primary mb-2">Insight</p>
            <p class="font-display font-bold text-foreground">Construction Risk Assessment →</p>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
