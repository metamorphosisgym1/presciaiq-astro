---
import Layout from '../../layouts/Layout.astro';

const title = "AI for Financial Services Australia | PresciaIQ";
const description = "Predictive AI for Australian financial services — forecast client churn, credit risk, and portfolio performance before outcomes occur. Get a demo.";
const canonicalURL = "https://www.presciaiq.com.au/industries/financial-services/";

const faqs = [
  {
    q: "How does PresciaIQ's financial forecasting differ from Power BI or Tableau?",
    a: "Power BI and Tableau are reporting tools — they show you what happened. PresciaIQ is a prediction engine — it tells you what will happen. Our financial forecasting module uses machine learning trained on your historical financial data to produce forward-looking cash flow, revenue, and churn predictions, not backward-looking dashboards."
  },
  {
    q: "What financial metrics can PresciaIQ predict?",
    a: "PresciaIQ's financial module predicts: 90-day cash flow with variance analysis, monthly recurring revenue (MRR) trajectory, customer churn probability by segment, accounts receivable collection likelihood, and budget vs actual variance forecasts. Custom prediction models can be built for any financial metric with sufficient historical data."
  },
  {
    q: "Is PresciaIQ suitable for ASX-listed companies or only SMEs?",
    a: "PresciaIQ serves both. Our SME tier is designed for businesses with $2M–$50M annual revenue. Our enterprise tier serves ASX-listed and larger private companies with complex multi-entity structures, custom data integrations, and dedicated model training. Contact us to discuss which tier fits your organisation."
  },
  {
    q: "How does PresciaIQ handle data security for financial data?",
    a: "All financial data processed by PresciaIQ is encrypted in transit and at rest using AES-256. We are SOC 2 Type II compliant and operate on Australian data centres (AWS ap-southeast-2). We do not use client financial data to train shared models — each client's prediction engine is trained exclusively on their own data."
  },
  {
    q: "What is the typical implementation timeline for financial services clients?",
    a: "For standard integrations with Xero, MYOB, or QuickBooks, implementation takes 3–4 weeks. For enterprise clients with custom ERP systems (SAP, Oracle, Microsoft Dynamics), allow 6–10 weeks for data architecture and model training."
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": title,
      "description": description,
      "url": canonicalURL,
      "dateModified": "2026-05-27",
      "relatedLink": [
        { "@type": "WebPage", "url": "https://www.presciaiq.com.au/insights/what-is-predictive-analytics-business/", "name": "What is Predictive Analytics for Business" },
        { "@type": "WebPage", "url": "https://www.presciaiq.com.au/insights/business-intelligence-evolution-australia/", "name": "Business Intelligence Evolution in Australia" },
        { "@type": "WebPage", "url": "https://www.presciaiq.com.au/insights/three-tests-for-predictive-intelligence/", "name": "Three Tests for Predictive Intelligence" }
      ],
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.presciaiq.com.au/" },
          { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://www.presciaiq.com.au/industries/" },
          { "@type": "ListItem", "position": 3, "name": "Financial Services", "item": canonicalURL }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    },
    { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".speakable-summary"] }
  ]
};
---

<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="relative bg-background text-foreground overflow-x-hidden min-h-screen">

    <!-- ═══ AMBIENT ATMOSPHERIC BACKDROP ═══ -->
    <div
      class="pointer-events-none fixed inset-0 z-0 bg-[radial-gradient(ellipse_at_top_right,rgba(0,255,136,0.12),transparent_60%)]"
      aria-hidden="true"
    ></div>

    <div
      class="pointer-events-none fixed inset-0 z-0 grid-overlay opacity-60"
      aria-hidden="true"
    ></div>

    <!-- ═══ 1. HERO SECTION ═══ -->
    <section class="relative z-10 border-b border-white/5">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-14 text-left md:text-center">

        <!-- Breadcrumb: Centered cleanly below navbar -->
        <nav class="w-full flex justify-center text-center mx-auto mb-6 text-xs font-mono text-[#8FAF8F] tracking-wide inline-flex items-center gap-2" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[#00FF88] transition-colors">Home</a>
          <span class="text-white/20">/</span>
          <a href="/industries/" class="hover:text-[#00FF88] transition-colors">Industries</a>
          <span class="text-white/20">/</span>
          <span class="text-[#F0EDE6]">Financial Services</span>
        </nav>

        <!-- Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-white/10 bg-white/[0.04] text-xs font-mono uppercase tracking-[0.2em] text-[#00FF88] mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00FF88] shadow-[0_0_8px_#00FF88]"></span>
          FINANCIAL SERVICES &amp; FINTECH // PresciaIQ Platform
        </div>

        <!-- Title -->
        <h1 class="text-4xl md:text-6xl font-serif font-semibold text-[#F0EDE6] tracking-tight mb-4 leading-[1.1]">
          Replace Reactive Reporting with <span class="text-[#00FF88] italic">Predictive Financial Intelligence</span>
        </h1>

        <!-- Subtitle -->
        <p class="speakable-summary text-[#C9CCC8] text-base md:text-lg font-sans max-w-2xl mx-auto mb-8 leading-relaxed">
          PresciaIQ's forecasting engine helps Australian CFOs, financial services firms, and fintech operators replace lagging KPI dashboards with forward-looking predictive models — cash flow, churn, and revenue forecasts with 89% accuracy.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/start/"
            id="hero-cta-finance-assessment"
            class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-full bg-[#00FF88] text-[#050508] font-semibold text-sm font-sans hover:bg-[#42FFAA] hover:shadow-[0_0_28px_rgba(0,255,136,0.45)] transition-all duration-300 hover:-translate-y-0.5"
          >
            Book a Free Financial AI Assessment →
          </a>
          <a
            href="/products/"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full border border-white/10 bg-white/[0.04] text-[#F0EDE6] font-semibold text-sm font-sans hover:border-[#00FF88]/40 hover:bg-white/[0.07] transition-all duration-300 backdrop-blur-md"
          >
            View All Products →
          </a>
        </div>

      </div>
    </section>

    <!-- ═══ 2. 4 METRIC BENTO CARDS ═══ -->
    <section class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 border-b border-white/5">
      <div class="text-left md:text-center max-w-3xl mx-auto mb-12" data-reveal="from-bottom">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-white/[0.03] text-xs font-mono uppercase tracking-[0.2em] text-[#00FF88] mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00FF88]"></span>
          PRECISION &amp; SECURITY
        </div>
        <h2 class="text-3xl md:text-5xl font-serif font-semibold text-[#F0EDE6] tracking-tight mb-4">
          Enterprise Financial Modelling
        </h2>
        <p class="text-[#C9CCC8] font-sans text-sm md:text-base leading-relaxed">
          Probabilistic financial intelligence designed for Australian regulatory compliance, strict data isolation, and forward-looking clarity.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        <!-- Metric 1: 89% -->
        <div
          data-reveal="from-bottom"
          data-reveal-delay="50"
          class="relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_10px_30px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 group flex flex-col justify-between"
        >
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
          <div class="absolute -right-16 -bottom-16 w-40 h-40 rounded-full opacity-0 group-hover:opacity-20 transition-opacity duration-500 pointer-events-none z-0" style="background: radial-gradient(circle, #00FF88 0%, transparent 70%);"></div>
          <div class="relative z-20">
            <p class="font-serif text-3xl md:text-4xl font-bold text-[#00FF88] mb-1 tracking-tight">89%</p>
            <p class="text-xs md:text-sm text-[#C9CCC8] font-sans leading-snug">Revenue forecast accuracy</p>
          </div>
          <p class="text-[11px] font-mono text-[#8FAF8F] mt-4 pt-3 border-t border-white/5 relative z-20">
            HOLDOUT-VALIDATED BENCHMARK
          </p>
        </div>

        <!-- Metric 2: 90d -->
        <div
          data-reveal="from-bottom"
          data-reveal-delay="100"
          class="relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_10px_30px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 group flex flex-col justify-between"
        >
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
          <div class="absolute -right-16 -bottom-16 w-40 h-40 rounded-full opacity-0 group-hover:opacity-20 transition-opacity duration-500 pointer-events-none z-0" style="background: radial-gradient(circle, #00FF88 0%, transparent 70%);"></div>
          <div class="relative z-20">
            <p class="font-serif text-3xl md:text-4xl font-bold text-[#00FF88] mb-1 tracking-tight">90d</p>
            <p class="text-xs md:text-sm text-[#C9CCC8] font-sans leading-snug">Cash flow prediction horizon</p>
          </div>
          <p class="text-[11px] font-mono text-[#8FAF8F] mt-4 pt-3 border-t border-white/5 relative z-20">
            PROBABILISTIC VARIANCE MODEL
          </p>
        </div>

        <!-- Metric 3: AES-256 -->
        <div
          data-reveal="from-bottom"
          data-reveal-delay="150"
          class="relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_10px_30px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 group flex flex-col justify-between"
        >
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
          <div class="absolute -right-16 -bottom-16 w-40 h-40 rounded-full opacity-0 group-hover:opacity-20 transition-opacity duration-500 pointer-events-none z-0" style="background: radial-gradient(circle, #00FF88 0%, transparent 70%);"></div>
          <div class="relative z-20">
            <p class="font-serif text-3xl md:text-4xl font-bold text-[#00FF88] mb-1 tracking-tight">AES-256</p>
            <p class="text-xs md:text-sm text-[#C9CCC8] font-sans leading-snug">Data encryption standard</p>
          </div>
          <p class="text-[11px] font-mono text-[#8FAF8F] mt-4 pt-3 border-t border-white/5 relative z-20">
            SOC 2 TYPE II COMPLIANT
          </p>
        </div>

        <!-- Metric 4: AU -->
        <div
          data-reveal="from-bottom"
          data-reveal-delay="200"
          class="relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_10px_30px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 group flex flex-col justify-between"
        >
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
          <div class="absolute -right-16 -bottom-16 w-40 h-40 rounded-full opacity-0 group-hover:opacity-20 transition-opacity duration-500 pointer-events-none z-0" style="background: radial-gradient(circle, #00FF88 0%, transparent 70%);"></div>
          <div class="relative z-20">
            <p class="font-serif text-3xl md:text-4xl font-bold text-[#00FF88] mb-1 tracking-tight">AU</p>
            <p class="text-xs md:text-sm text-[#C9CCC8] font-sans leading-snug">Data sovereignty — local servers only</p>
          </div>
          <p class="text-[11px] font-mono text-[#8FAF8F] mt-4 pt-3 border-t border-white/5 relative z-20">
            AWS SYDNEY AP-SOUTHEAST-2
          </p>
        </div>

      </div>
    </section>

    <!-- ═══ 3. FREQUENTLY ASKED QUESTIONS ═══ -->
    <section class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 border-b border-white/5">
      <div class="text-left md:text-center mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-white/[0.03] text-xs font-mono uppercase tracking-[0.2em] text-[#00FF88] mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00FF88]"></span>
          FREQUENTLY ASKED QUESTIONS
        </div>
        <h2 class="text-3xl md:text-4xl font-serif font-semibold text-[#F0EDE6] tracking-tight">
          Financial Services AI — Common Questions
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, idx) => (
          <details
            data-reveal="from-bottom"
            data-reveal-delay={(idx * 50).toString()}
            class="rounded-2xl border border-white/10 bg-[#111411]/70 backdrop-blur-md p-6 mb-4 hover:border-white/20 transition-all group cursor-pointer"
          >
            <summary class="flex items-center justify-between text-lg font-serif font-semibold text-[#F0EDE6] group-open:text-[#00FF88] transition-colors list-none select-none mb-2">
              <span>{faq.q}</span>
              <span class="w-6 h-6 rounded-full border border-white/10 flex items-center justify-center text-xs text-[#00FF88] group-open:rotate-180 transition-transform duration-300 ml-4 shrink-0">
                ↓
              </span>
            </summary>
            <p class="text-sm text-[#C9CCC8] font-sans leading-relaxed pt-3 border-t border-white/5">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- ═══ 4. RELATED LINKS (3 CARDS) ═══ -->
    <section class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
      <div class="text-left md:text-center mb-8">
        <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#00FF88] block mb-2 font-semibold">
          EXPLORE FURTHER
        </span>
        <h2 class="font-serif text-2xl md:text-3xl font-semibold text-[#F0EDE6]">
          Related Intelligence &amp; Solutions
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- Card 1: AI for CFO Forecasting -->
        <a
          href="/answers/what-is-predictive-ai/"
          data-reveal="from-bottom"
          data-reveal-delay="0"
          class="relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 group block"
        >
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
          <div class="relative z-20">
            <span class="text-xs font-mono text-[#00FF88] uppercase tracking-wider block mb-2 font-semibold">Answer</span>
            <p class="font-serif font-semibold text-lg text-[#F0EDE6] group-hover:text-[#00FF88] transition-colors flex items-center justify-between">
              AI for CFO Forecasting
              <span class="text-xs font-mono group-hover:translate-x-1 transition-transform">→</span>
            </p>
            <p class="text-xs text-[#C9CCC8] mt-2 font-sans leading-relaxed">
              How predictive intelligence transforms FP&amp;A from backward-looking to probabilistic.
            </p>
          </div>
        </a>

        <!-- Card 2: All Industries -->
        <a
          href="/industries/"
          data-reveal="from-bottom"
          data-reveal-delay="80"
          class="relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 group block"
        >
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
          <div class="relative z-20">
            <span class="text-xs font-mono text-[#00FF88] uppercase tracking-wider block mb-2 font-semibold">Industries</span>
            <p class="font-serif font-semibold text-lg text-[#F0EDE6] group-hover:text-[#00FF88] transition-colors flex items-center justify-between">
              All Industries
              <span class="text-xs font-mono group-hover:translate-x-1 transition-transform">→</span>
            </p>
            <p class="text-xs text-[#C9CCC8] mt-2 font-sans leading-relaxed">
              Explore predictive AI solutions engineered for Australian commercial sectors.
            </p>
          </div>
        </a>

        <!-- Card 3: Book Assessment -->
        <a
          href="/start/"
          data-reveal="from-bottom"
          data-reveal-delay="160"
          class="relative overflow-hidden rounded-2xl border border-white/10 bg-[#111411]/80 backdrop-blur-xl p-6 transition-all duration-300 hover:border-[#00FF88]/50 hover:shadow-[0_12px_35px_-8px_rgba(0,255,136,0.22)] hover:-translate-y-1 group block"
        >
          <div class="absolute inset-0 pointer-events-none -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out bg-gradient-to-r from-transparent via-white/[0.08] to-transparent skew-x-12 z-10"></div>
          <div class="relative z-20">
            <span class="text-xs font-mono text-[#00FF88] uppercase tracking-wider block mb-2 font-semibold">Get Started</span>
            <p class="font-serif font-semibold text-lg text-[#F0EDE6] group-hover:text-[#00FF88] transition-colors flex items-center justify-between">
              Book Assessment
              <span class="text-xs font-mono group-hover:translate-x-1 transition-transform">→</span>
            </p>
            <p class="text-xs text-[#C9CCC8] mt-2 font-sans leading-relaxed">
              Run a risk and revenue prediction diagnostic with our engineering team.
            </p>
          </div>
        </a>
      </div>
    </section>

  </main>

  <!-- ═══ 5. DIRECTIONAL SCROLL ENTRANCE SCRIPT ═══ -->
  <script is:inline>
    (function () {
      const INIT = {
        'from-left':   { transform: 'translateX(-20px)', opacity: '0' },
        'from-right':  { transform: 'translateX(20px)',  opacity: '0' },
        'from-bottom': { transform: 'translateY(20px)',  opacity: '0' },
      };

      const targets = document.querySelectorAll('[data-reveal]');

      targets.forEach(el => {
        const dir = el.getAttribute('data-reveal');
        const init = INIT[dir];
        if (!init) return;
        Object.assign(el.style, init);
        el.style.transition = 'transform 400ms cubic-bezier(0.16, 1, 0.3, 1), opacity 400ms cubic-bezier(0.16, 1, 0.3, 1)';
        el.style.willChange = 'transform, opacity';
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const el = entry.target;
            const delay = parseInt(el.getAttribute('data-reveal-delay') || '0', 10);
            setTimeout(() => {
              el.style.transform = 'translate(0, 0)';
              el.style.opacity = '1';
            }, delay);
            observer.unobserve(el);
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      targets.forEach(el => observer.observe(el));

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        targets.forEach(el => {
          el.style.transform = 'none';
          el.style.opacity = '1';
          el.style.transition = 'none';
        });
      }
    })();
  </script>
</Layout>
