---
import Layout from '../../layouts/Layout.astro';

const title = "The Silk Studio Case Study — PresciaIQ | Fashion & Lifestyle · Australia";
const description = "How PresciaIQ built The Silk Studio's SEO foundation to capture high-intent fashion and lifestyle queries across Australia without relying on paid advertising.";
const canonicalURL = "/case-studies/the-silk-studio/";

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "url": `https://www.presciaiq.com.au${canonicalURL}`,
  "publisher": { "@type": "Organization", "name": "PresciaIQ", "url": "https://www.presciaiq.com.au" },
  "datePublished": "2026-07-01",
  "dateModified": "2026-08-10",
  "about": [
    { "@type": "Thing", "name": "The Silk Studio" },
    { "@type": "Thing", "name": "PresciaIQ" },
    { "@type": "Thing", "name": "SEO" }
  ]
};
---

<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="min-h-screen bg-background text-foreground">

    <!-- Hero -->
    <section class="pt-12 pb-16 border-b border-white/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <a href="/case-studies" class="text-xs uppercase tracking-[0.25em] text-muted-foreground font-sans hover:text-primary transition-colors">&larr; All Case Studies</a>
          <span class="text-muted-foreground/30">|</span>
          <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold text-primary border border-primary/20 bg-primary/5">E-commerce SEO</span>
          <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold border border-white/10 text-muted-foreground">Fashion & Lifestyle · Australia</span>
        </div>
        <h1 class="font-display text-4xl md:text-6xl font-black text-foreground mb-4 leading-tight">
          The Silk Studio: Organic traffic<br />
          <span class="text-primary">that converts.</span>
        </h1>
        <p class="text-lg text-muted-foreground font-sans max-w-2xl mb-8">How PresciaIQ built The Silk Studio's SEO foundation to capture high-intent fashion and lifestyle queries across Australia without relying on paid advertising.</p>
        <a href="https://thesilkstudio.com.au" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm text-primary font-mono hover:underline">
          thesilkstudio.com.au &rarr;
        </a>
      </div>
    </section>

    <!-- Results bar -->
    <section class="py-12 border-b border-white/5 bg-primary/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">Organic</div>
                <div class="text-sm text-muted-foreground font-sans">Traffic channel built</div>
              </div>
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">Schema</div>
                <div class="text-sm text-muted-foreground font-sans">Product markup live</div>
              </div>
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">0</div>
                <div class="text-sm text-muted-foreground font-sans">Ad spend required</div>
              </div>
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">Live</div>
                <div class="text-sm text-muted-foreground font-sans">On presciaiq.com.au</div>
              </div>
        </div>
      </div>
    </section>

    <!-- Problem / Solution -->
    <section class="py-16 border-b border-white/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12">
          <div>
            <h2 class="font-display text-2xl font-bold text-foreground mb-4">The Problem</h2>
            <p class="text-muted-foreground font-sans leading-relaxed">The Silk Studio had a beautiful product range but was relying on paid social media advertising for all traffic. Organic search was an untapped channel with significant potential for the brand.</p>
          </div>
          <div>
            <h2 class="font-display text-2xl font-bold text-foreground mb-4">The Solution</h2>
            <p class="text-muted-foreground font-sans leading-relaxed">PresciaIQ implemented a structured SEO architecture for The Silk Studio including product schema, collection page optimisation, and content targeting fashion-related queries across Australian markets.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Quote -->
    <section class="py-16 border-b border-white/5">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <blockquote class="font-display text-2xl md:text-3xl font-bold text-foreground mb-6 leading-tight">
          &ldquo;PresciaIQ gave us a roadmap to reduce our dependence on paid ads and build a sustainable organic traffic channel.&rdquo;
        </blockquote>
        <cite class="text-primary font-mono text-sm not-italic">&mdash; The Silk Studio</cite>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="font-display text-3xl md:text-4xl font-black text-foreground mb-4">Want results like these?</h2>
        <p class="text-muted-foreground font-sans mb-8">Book a free strategy call and we'll show you exactly what PresciaIQ can do for your business.</p>
        <a href="/start" class="inline-flex items-center gap-2 bg-primary text-primary-foreground font-mono font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors text-sm uppercase tracking-wider">
          Book a Free Strategy Call &rarr;
        </a>
      </div>
    </section>

  </main>
</Layout>
