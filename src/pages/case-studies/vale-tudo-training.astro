---
import Layout from '../../layouts/Layout.astro';

const title = "Vale Tudo Training Case Study — PresciaIQ | Martial Arts · Australia";
const description = "How PresciaIQ established Vale Tudo Training's digital presence with a structured web architecture designed to capture local and national martial arts training queries.";
const canonicalURL = "/case-studies/vale-tudo-training/";

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "url": `https://www.presciaiq.com.au${canonicalURL}`,
  "publisher": { "@type": "Organization", "name": "PresciaIQ", "url": "https://www.presciaiq.com.au" },
  "datePublished": "2026-07-01",
  "dateModified": "2026-08-10",
  "about": [
    { "@type": "Thing", "name": "Vale Tudo Training" },
    { "@type": "Thing", "name": "PresciaIQ" },
    { "@type": "Thing", "name": "SEO" }
  ]
};
---

<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="min-h-screen bg-background text-foreground">

    <!-- Hero -->
    <section class="pt-12 pb-16 border-b border-white/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <a href="/case-studies" class="text-xs uppercase tracking-[0.25em] text-muted-foreground font-sans hover:text-primary transition-colors">&larr; All Case Studies</a>
          <span class="text-muted-foreground/30">|</span>
          <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold text-primary border border-primary/20 bg-primary/5">Digital Presence</span>
          <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold border border-white/10 text-muted-foreground">Martial Arts · Australia</span>
        </div>
        <h1 class="font-display text-4xl md:text-6xl font-black text-foreground mb-4 leading-tight">
          Vale Tudo Training: Built for<br />
          <span class="text-primary">search from day one.</span>
        </h1>
        <p class="text-lg text-muted-foreground font-sans max-w-2xl mb-8">How PresciaIQ established Vale Tudo Training's digital presence with a structured web architecture designed to capture local and national martial arts training queries.</p>
        <a href="https://valetraining.com.au" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm text-primary font-mono hover:underline">
          valetraining.com.au &rarr;
        </a>
      </div>
    </section>

    <!-- Results bar -->
    <section class="py-12 border-b border-white/5 bg-primary/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">Local</div>
                <div class="text-sm text-muted-foreground font-sans">SEO optimised</div>
              </div>
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">Schema</div>
                <div class="text-sm text-muted-foreground font-sans">Markup implemented</div>
              </div>
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">Fast</div>
                <div class="text-sm text-muted-foreground font-sans">Core Web Vitals</div>
              </div>
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">Live</div>
                <div class="text-sm text-muted-foreground font-sans">On presciaiq.com.au</div>
              </div>
        </div>
      </div>
    </section>

    <!-- Problem / Solution -->
    <section class="py-16 border-b border-white/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12">
          <div>
            <h2 class="font-display text-2xl font-bold text-foreground mb-4">The Problem</h2>
            <p class="text-muted-foreground font-sans leading-relaxed">Vale Tudo Training needed a professional digital presence that would rank for martial arts training queries in their target markets. Their existing online presence was minimal and not optimised for search.</p>
          </div>
          <div>
            <h2 class="font-display text-2xl font-bold text-foreground mb-4">The Solution</h2>
            <p class="text-muted-foreground font-sans leading-relaxed">PresciaIQ built a structured web presence for Vale Tudo Training with proper schema markup, local SEO optimisation, and content architecture targeting martial arts training queries across Australia.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Quote -->
    <section class="py-16 border-b border-white/5">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <blockquote class="font-display text-2xl md:text-3xl font-bold text-foreground mb-6 leading-tight">
          &ldquo;PresciaIQ understood what we needed and delivered a professional digital presence that works for our business.&rdquo;
        </blockquote>
        <cite class="text-primary font-mono text-sm not-italic">&mdash; Vale Tudo Training</cite>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="font-display text-3xl md:text-4xl font-black text-foreground mb-4">Want results like these?</h2>
        <p class="text-muted-foreground font-sans mb-8">Book a free strategy call and we'll show you exactly what PresciaIQ can do for your business.</p>
        <a href="/start" class="inline-flex items-center gap-2 bg-primary text-primary-foreground font-mono font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors text-sm uppercase tracking-wider">
          Book a Free Strategy Call &rarr;
        </a>
      </div>
    </section>

  </main>
</Layout>
