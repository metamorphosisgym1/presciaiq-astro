---
import Layout from '../../layouts/Layout.astro';

const title = "Loop BC Case Study — PresciaIQ | Business Consulting · NSW";
const description = "How PresciaIQ built Loop BC's digital authority through a 25-post insights architecture, AEO schema, and AI citation strategy — positioning them as the go-to operating model consultancy in Australia.";
const canonicalURL = "/case-studies/loop-bc/";

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "url": `https://www.presciaiq.com.au${canonicalURL}`,
  "publisher": { "@type": "Organization", "name": "PresciaIQ", "url": "https://www.presciaiq.com.au" },
  "datePublished": "2026-07-01",
  "dateModified": "2026-08-10",
  "about": [
    { "@type": "Thing", "name": "Loop BC" },
    { "@type": "Thing", "name": "PresciaIQ" },
    { "@type": "Thing", "name": "SEO" }
  ]
};
---

<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="min-h-screen bg-background text-foreground">

    <!-- Hero -->
    <section class="pt-12 pb-16 border-b border-white/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <a href="/case-studies" class="text-xs uppercase tracking-[0.25em] text-muted-foreground font-sans hover:text-primary transition-colors">&larr; All Case Studies</a>
          <span class="text-muted-foreground/30">|</span>
          <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold text-primary border border-primary/20 bg-primary/5">SEO & AEO Architecture</span>
          <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold border border-white/10 text-muted-foreground">Business Consulting · NSW</span>
        </div>
        <h1 class="font-display text-4xl md:text-6xl font-black text-foreground mb-4 leading-tight">
          Loop BC: From invisible to cited<br />
          <span class="text-primary">by AI search engines.</span>
        </h1>
        <p class="text-lg text-muted-foreground font-sans max-w-2xl mb-8">How PresciaIQ built Loop BC's digital authority through a 25-post insights architecture, AEO schema, and AI citation strategy — positioning them as the go-to operating model consultancy in Australia.</p>
        <a href="https://loopbc.com.au" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm text-primary font-mono hover:underline">
          loopbc.com.au &rarr;
        </a>
      </div>
    </section>

    <!-- Results bar -->
    <section class="py-12 border-b border-white/5 bg-primary/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">25</div>
                <div class="text-sm text-muted-foreground font-sans">New blog posts published</div>
              </div>
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">16</div>
                <div class="text-sm text-muted-foreground font-sans">Total indexed pages</div>
              </div>
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">AEO</div>
                <div class="text-sm text-muted-foreground font-sans">Schema on all pages</div>
              </div>
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">Vercel</div>
                <div class="text-sm text-muted-foreground font-sans">Deployed & live</div>
              </div>
        </div>
      </div>
    </section>

    <!-- Problem / Solution -->
    <section class="py-16 border-b border-white/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12">
          <div>
            <h2 class="font-display text-2xl font-bold text-foreground mb-4">The Problem</h2>
            <p class="text-muted-foreground font-sans leading-relaxed">Loop BC had deep expertise but near-zero online visibility. Their consulting services weren't appearing in Google or AI search results for any of their target queries. Prospective clients couldn't find them.</p>
          </div>
          <div>
            <h2 class="font-display text-2xl font-bold text-foreground mb-4">The Solution</h2>
            <p class="text-muted-foreground font-sans leading-relaxed">PresciaIQ deployed a full SEO/AEO architecture: 25 structured blog posts (Issues 06–36) covering operating model design, executive advisory, and transformation case studies. Each post included Article schema, FAQPage markup, and internal linking. The site was migrated to Astro on Vercel for static generation and fast load times.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Quote -->
    <section class="py-16 border-b border-white/5">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <blockquote class="font-display text-2xl md:text-3xl font-bold text-foreground mb-6 leading-tight">
          &ldquo;The content architecture PresciaIQ built positions Loop BC exactly where our clients are looking — in AI search results and Google for operating model queries.&rdquo;
        </blockquote>
        <cite class="text-primary font-mono text-sm not-italic">&mdash; Loop BC</cite>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="font-display text-3xl md:text-4xl font-black text-foreground mb-4">Want results like these?</h2>
        <p class="text-muted-foreground font-sans mb-8">Book a free strategy call and we'll show you exactly what PresciaIQ can do for your business.</p>
        <a href="/start" class="inline-flex items-center gap-2 bg-primary text-primary-foreground font-mono font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors text-sm uppercase tracking-wider">
          Book a Free Strategy Call &rarr;
        </a>
      </div>
    </section>

  </main>
</Layout>
