---
import Layout from '../../layouts/Layout.astro';

const title = "Modern Body Method Case Study — PresciaIQ | Fitness Coaching · Australia";
const description = "How PresciaIQ migrated Modern Body Method from Lovable to a production-grade Vercel deployment with 1,500+ programmatic SEO pages targeting fitness coaching queries across Australia.";
const canonicalURL = "/case-studies/modern-body-method/";

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "url": `https://www.presciaiq.com.au${canonicalURL}`,
  "publisher": { "@type": "Organization", "name": "PresciaIQ", "url": "https://www.presciaiq.com.au" },
  "datePublished": "2026-07-01",
  "dateModified": "2026-08-10",
  "about": [
    { "@type": "Thing", "name": "Modern Body Method" },
    { "@type": "Thing", "name": "PresciaIQ" },
    { "@type": "Thing", "name": "SEO" }
  ]
};
---

<Layout title={title} description={description} canonicalURL={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="min-h-screen bg-background text-foreground">

    <!-- Hero -->
    <section class="pt-12 pb-16 border-b border-white/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <a href="/case-studies" class="text-xs uppercase tracking-[0.25em] text-muted-foreground font-sans hover:text-primary transition-colors">&larr; All Case Studies</a>
          <span class="text-muted-foreground/30">|</span>
          <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold text-primary border border-primary/20 bg-primary/5">pSEO & Web Migration</span>
          <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold border border-white/10 text-muted-foreground">Fitness Coaching · Australia</span>
        </div>
        <h1 class="font-display text-4xl md:text-6xl font-black text-foreground mb-4 leading-tight">
          Modern Body Method: 1,500+ pages,<br />
          <span class="text-primary">zero ad spend.</span>
        </h1>
        <p class="text-lg text-muted-foreground font-sans max-w-2xl mb-8">How PresciaIQ migrated Modern Body Method from Lovable to a production-grade Vercel deployment with 1,500+ programmatic SEO pages targeting fitness coaching queries across Australia.</p>
        <a href="https://modernbodymethod.com" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm text-primary font-mono hover:underline">
          modernbodymethod.com &rarr;
        </a>
      </div>
    </section>

    <!-- Results bar -->
    <section class="py-12 border-b border-white/5 bg-primary/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">1,500+</div>
                <div class="text-sm text-muted-foreground font-sans">Programmatic SEO pages</div>
              </div>
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">30</div>
                <div class="text-sm text-muted-foreground font-sans">Australian locations targeted</div>
              </div>
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">25</div>
                <div class="text-sm text-muted-foreground font-sans">AEO answer pages</div>
              </div>
              <div class="text-center">
                <div class="font-display text-4xl font-black text-primary mb-1">10</div>
                <div class="text-sm text-muted-foreground font-sans">Competitor comparison pages</div>
              </div>
        </div>
      </div>
    </section>

    <!-- Problem / Solution -->
    <section class="py-16 border-b border-white/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12">
          <div>
            <h2 class="font-display text-2xl font-bold text-foreground mb-4">The Problem</h2>
            <p class="text-muted-foreground font-sans leading-relaxed">Modern Body Method had a well-designed Lovable site but no SEO architecture. The site had minimal pages, no programmatic SEO, and no AEO content — meaning Mac Burke's coaching expertise was invisible to potential clients searching online.</p>
          </div>
          <div>
            <h2 class="font-display text-2xl font-bold text-foreground mb-4">The Solution</h2>
            <p class="text-muted-foreground font-sans leading-relaxed">PresciaIQ migrated the site to TanStack Start on Vercel, preserving the exact design while adding a 1,500+ page programmatic SEO architecture. The architecture covers 5 service types × 10 audience segments × 30 Australian locations, plus 25 AEO answer pages and 10 competitor comparison pages.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Quote -->
    <section class="py-16 border-b border-white/5">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <blockquote class="font-display text-2xl md:text-3xl font-bold text-foreground mb-6 leading-tight">
          &ldquo;PresciaIQ took our Lovable site and turned it into a serious SEO machine without changing a single pixel of the design.&rdquo;
        </blockquote>
        <cite class="text-primary font-mono text-sm not-italic">&mdash; Macauley Burke, Modern Body Method</cite>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="font-display text-3xl md:text-4xl font-black text-foreground mb-4">Want results like these?</h2>
        <p class="text-muted-foreground font-sans mb-8">Book a free strategy call and we'll show you exactly what PresciaIQ can do for your business.</p>
        <a href="/start" class="inline-flex items-center gap-2 bg-primary text-primary-foreground font-mono font-bold px-8 py-4 rounded-lg hover:bg-primary/90 transition-colors text-sm uppercase tracking-wider">
          Book a Free Strategy Call &rarr;
        </a>
      </div>
    </section>

  </main>
</Layout>
